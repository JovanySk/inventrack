---
import Layout from '../layouts/Layout.astro';
---

<Layout title="XML">
<style is:global>
  .xml-grid { display: grid; gap: 18px; max-width: 760px; }

  .xml-panel {
    border-radius: 14px; border: 1px solid rgba(150,80,255,0.12);
    background: rgba(255,255,255,0.02); overflow: hidden;
  }

  .xml-panel-head {
    display: flex; align-items: center; gap: 12px;
    padding: 16px 20px; border-bottom: 1px solid rgba(150,80,255,0.08);
    background: rgba(150,80,255,0.04);
  }
  .xml-icon {
    width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 18px;
  }
  .xml-icon-down { background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.2); }
  .xml-icon-up   { background: rgba(168,85,247,0.12);  border: 1px solid rgba(168,85,247,0.2); }
  .xml-icon-doc  { background: rgba(6,182,212,0.1);    border: 1px solid rgba(6,182,212,0.2); }
  .xml-head-title { font-size: 14px; font-weight: 600; color: #e2d9f3; }
  .xml-head-desc  { font-size: 12px; color: rgba(180,150,255,0.45); margin-top: 2px; }

  .xml-panel-body { padding: 18px 20px; }

  /* Code preview */
  .code-block {
    background: rgba(5,2,16,0.8); border: 1px solid rgba(150,80,255,0.1);
    border-radius: 10px; padding: 16px; overflow-x: auto;
    font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.6;
    color: rgba(180,150,255,0.6);
  }
  .code-block .xml-tag  { color: #93c5fd; }
  .code-block .xml-attr { color: #c084fc; }
  .code-block .xml-val  { color: #34d399; }
  .code-block .xml-text { color: #e2d9f3; }
  .code-block .xml-comm { color: rgba(180,150,255,0.3); }

  /* Buttons */
  .btn-export {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 22px; border: none; border-radius: 10px;
    background: linear-gradient(135deg, #10b981, #059669);
    color: #fff; font-size: 13px; font-weight: 600; font-family: 'Inter', sans-serif;
    cursor: pointer; transition: all 0.2s;
    box-shadow: 0 4px 16px rgba(16,185,129,0.25);
  }
  .btn-export:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(16,185,129,0.4); }
  .btn-export:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-export svg { width: 15px; height: 15px; }

  .btn-import {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 11px; border: none; border-radius: 10px;
    background: linear-gradient(135deg, #a855f7, #ec4899);
    color: #fff; font-size: 13px; font-weight: 600; font-family: 'Inter', sans-serif;
    cursor: pointer; transition: all 0.2s; margin-top: 14px;
    box-shadow: 0 4px 16px rgba(168,85,247,0.25);
  }
  .btn-import:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(168,85,247,0.4); }
  .btn-import:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-import svg { width: 15px; height: 15px; }

  /* Drop zone */
  .drop-zone {
    border: 2px dashed rgba(150,80,255,0.25); border-radius: 12px;
    padding: 32px; text-align: center; cursor: pointer;
    transition: all 0.2s; margin-bottom: 0;
  }
  .drop-zone:hover, .drop-zone.over {
    border-color: rgba(168,85,247,0.55); background: rgba(168,85,247,0.04);
  }
  .drop-icon { font-size: 28px; margin-bottom: 8px; }
  .drop-text { font-size: 13px; font-weight: 500; color: rgba(180,150,255,0.6); }
  .drop-hint { font-size: 11px; color: rgba(180,150,255,0.35); margin-top: 4px; }

  .file-selected { display: flex; align-items: center; gap: 10px; }
  .file-name { font-size: 13px; font-weight: 500; color: #c084fc; }
  .file-size { font-size: 11px; color: rgba(180,150,255,0.4); }
  .file-icon { font-size: 24px; }

  /* Import result */
  .import-result { display: none; border-radius: 12px; padding: 18px; border: 1px solid; margin-top: 14px; }
  .import-result.ok  { background: rgba(16,185,129,0.07); border-color: rgba(16,185,129,0.2); }
  .import-result.err { background: rgba(239,68,68,0.07);  border-color: rgba(239,68,68,0.2); }
  .result-title { font-size: 13px; font-weight: 700; margin-bottom: 12px; }
  .result-title.ok  { color: #34d399; }
  .result-title.err { color: #f87171; }
  .result-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
  .result-stat { text-align: center; }
  .result-stat-num { font-size: 22px; font-weight: 900; }
  .result-stat-label { font-size: 10px; color: rgba(180,150,255,0.4); margin-top: 2px; }
  .result-link { display: inline-block; margin-top: 14px; font-size: 12px; font-weight: 600; color: rgba(168,85,247,0.8); text-decoration: none; }
  .result-link:hover { color: #ec4899; }
</style>

  <div class="xml-grid">

    <!-- Formato XML -->
    <div class="xml-panel">
      <div class="xml-panel-head">
        <div class="xml-icon xml-icon-doc">📄</div>
        <div>
          <div class="xml-head-title">Formato del archivo XML</div>
          <div class="xml-head-desc">Estructura estándar para importar y exportar inventario</div>
        </div>
      </div>
      <div class="xml-panel-body">
        <div class="code-block">
<span class="xml-comm">&lt;?xml version="1.0" encoding="UTF-8"?&gt;</span>
<span class="xml-tag">&lt;inventario</span> <span class="xml-attr">version=</span><span class="xml-val">"1.0"</span> <span class="xml-attr">empresa=</span><span class="xml-val">"Mi Empresa"</span><span class="xml-tag">&gt;</span>
  <span class="xml-tag">&lt;productos&gt;</span>
    <span class="xml-tag">&lt;producto&gt;</span>
      <span class="xml-tag">&lt;nombre&gt;</span><span class="xml-text">Laptop Dell XPS 13</span><span class="xml-tag">&lt;/nombre&gt;</span>
      <span class="xml-tag">&lt;sku&gt;</span><span class="xml-text">ELEC-001</span><span class="xml-tag">&lt;/sku&gt;</span>
      <span class="xml-tag">&lt;categoria&gt;</span><span class="xml-text">Electrónica</span><span class="xml-tag">&lt;/categoria&gt;</span>
      <span class="xml-tag">&lt;precio&gt;</span><span class="xml-text">15999.99</span><span class="xml-tag">&lt;/precio&gt;</span>
      <span class="xml-tag">&lt;stock&gt;</span><span class="xml-text">8</span><span class="xml-tag">&lt;/stock&gt;</span>
      <span class="xml-tag">&lt;stockMinimo&gt;</span><span class="xml-text">3</span><span class="xml-tag">&lt;/stockMinimo&gt;</span>
    <span class="xml-tag">&lt;/producto&gt;</span>
  <span class="xml-tag">&lt;/productos&gt;</span>
<span class="xml-tag">&lt;/inventario&gt;</span>
        </div>
      </div>
    </div>

    <!-- Exportar -->
    <div class="xml-panel">
      <div class="xml-panel-head">
        <div class="xml-icon xml-icon-down">📤</div>
        <div>
          <div class="xml-head-title">Exportar inventario</div>
          <div class="xml-head-desc">Descarga todos los productos en formato XML</div>
        </div>
      </div>
      <div class="xml-panel-body">
        <button id="exportBtn" class="btn-export" onclick="exportXml()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Descargar XML
        </button>
      </div>
    </div>

    <!-- Importar -->
    <div class="xml-panel">
      <div class="xml-panel-head">
        <div class="xml-icon xml-icon-up">📥</div>
        <div>
          <div class="xml-head-title">Importar productos</div>
          <div class="xml-head-desc">Carga masiva desde archivo XML · SKUs duplicados se ignoran</div>
        </div>
      </div>
      <div class="xml-panel-body">
        <input type="file" id="xmlFile" accept=".xml" style="display:none" onchange="previewFile()" />

        <div class="drop-zone" id="dropZone" onclick="document.getElementById('xmlFile').click()">
          <div id="dropContent">
            <div class="drop-icon">📂</div>
            <div class="drop-text">Haz clic para seleccionar un archivo XML</div>
            <div class="drop-hint">Solo archivos .xml</div>
          </div>
        </div>

        <button id="importBtn" class="btn-import" onclick="importXml()" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          Importar Productos
        </button>

        <div id="importResult" class="import-result"></div>
      </div>
    </div>

  </div>

  <script>
    async function exportXml() {
      const btn = document.getElementById('exportBtn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Generando...';
      try {
        const res  = await fetch('/api/xml');
        const blob = await res.blob();
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href     = url;
        a.download = res.headers.get('content-disposition')?.match(/filename="(.+)"/)?.[1]
                     ?? `inventario_${new Date().toISOString().split('T')[0]}.xml`;
        a.click(); URL.revokeObjectURL(url);
      } catch (err: any) { alert('Error al exportar: ' + err.message); }
      finally { btn.disabled = false; btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>Descargar XML`; }
    }

    function previewFile() {
      const file = (document.getElementById('xmlFile') as HTMLInputElement).files?.[0];
      if (!file) return;
      document.getElementById('dropContent')!.innerHTML = `
        <div class="file-selected">
          <span class="file-icon">📄</span>
          <div>
            <div class="file-name">${file.name}</div>
            <div class="file-size">${(file.size / 1024).toFixed(1)} KB</div>
          </div>
        </div>`;
      (document.getElementById('importBtn') as HTMLButtonElement).disabled = false;
    }

    async function importXml() {
      const file = (document.getElementById('xmlFile') as HTMLInputElement).files?.[0];
      if (!file) return;
      const btn = document.getElementById('importBtn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Importando...';
      const form = new FormData(); form.append('file', file);
      try {
        const res  = await fetch('/api/xml', { method: 'POST', body: form });
        const data = await res.json();
        const r    = document.getElementById('importResult')!;
        r.style.display = 'block';
        if (res.ok && data.ok) {
          r.className = 'import-result ok';
          r.innerHTML = `<div class="result-title ok">✓ Importación exitosa</div>
            <div class="result-stats">
              <div class="result-stat"><div class="result-stat-num" style="color:#34d399">${data.imported}</div><div class="result-stat-label">Importados</div></div>
              <div class="result-stat"><div class="result-stat-num" style="color:#fbbf24">${data.skipped}</div><div class="result-stat-label">Ignorados (SKU dup.)</div></div>
              <div class="result-stat"><div class="result-stat-num" style="color:#e2d9f3">${data.total}</div><div class="result-stat-label">Total en archivo</div></div>
            </div>
            <a href="/productos" class="result-link">→ Ver productos</a>`;
        } else {
          r.className = 'import-result err';
          r.innerHTML = `<div class="result-title err">✗ Error en la importación</div>
            <p style="font-size:13px;color:#fca5a5">${data.error ?? 'Error desconocido'}</p>`;
        }
      } catch (err: any) { alert('Error: ' + err.message); }
      finally { btn.disabled = false; btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>Importar Productos`; }
    }

    Object.assign(window, { exportXml, importXml, previewFile });
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
const role = Astro.cookies.get('inventrack-role')?.value || 'demo';
const canImport = role === 'admin' || role === 'empleado';
---

<Layout title="Importar y exportar" subtitle="Intercambio de catálogo en formato XML">
  <style is:global>
    .xml-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; align-items: start; }
    .xml-grid .full { grid-column: 1 / -1; }
    .drop {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-align: center;
      min-height: 168px; padding: 24px; border-radius: var(--radius-lg);
      border: 1.5px dashed var(--border-strong); background: var(--surface-2);
      cursor: pointer; transition: border-color .15s, background-color .15s;
    }
    .drop:hover, .drop.over { border-color: var(--accent); background: var(--accent-soft); }
    .drop-ic { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--surface); border: 1px solid var(--border); color: var(--text-2); margin-bottom: 4px; }
    .drop-ic svg { width: 18px; height: 18px; }
    .drop b { font-size: 13.5px; font-weight: 600; }
    .drop span { font-size: 12.5px; color: var(--text-3); }
    .file-row { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
    .file-row .drop-ic { margin: 0; width: 34px; height: 34px; }
    .file-row b { font-size: 13px; font-weight: 600; display: block; }
    .file-row span { font-size: 12px; color: var(--text-3); }
    .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 12px; }
    .stat { padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--border); }
    .stat .k { font-size: 12px; color: var(--text-3); }
    .stat .v { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
    .code {
      margin: 0; padding: 14px 16px; overflow-x: auto;
      font: 12px/1.7 var(--font-mono); color: var(--text-2);
      background: var(--surface-2); border-top: 1px solid var(--border);
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }
    .code .t { color: var(--accent-text); }
    .code .a { color: var(--chart-4); }
    .code .s { color: var(--success); }
    .code .c { color: var(--text-3); }
    .export-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px; }
    .checklist { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; font-size: 13px; color: var(--text-2); }
    .checklist li { display: flex; gap: 8px; align-items: flex-start; }
    .checklist svg { width: 15px; height: 15px; color: var(--success); flex-shrink: 0; margin-top: 2px; }
    @media (max-width: 900px) { .xml-grid { grid-template-columns: minmax(0, 1fr); } }
  </style>

  <div class="xml-grid">
    <section class="card">
      <div class="card-head">
        <div><h3 class="card-title">Importar productos</h3><p class="card-sub">Carga masiva desde un archivo .xml de hasta 2 MB</p></div>
      </div>
      <div class="card-body">
        {canImport ? (
          <>
            <input type="file" id="xmlFile" accept=".xml,application/xml,text/xml" hidden />
            <div class="drop" id="dropZone" role="button" tabindex="0" aria-label="Seleccionar archivo XML">
              <div class="drop-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3m-5 5 5-5 5 5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/></svg></div>
              <b>Arrastra un archivo XML o haz clic para elegirlo</b>
              <span>Los SKU que ya existen se omiten para evitar duplicados</span>
            </div>
            <div id="fileInfo" style="display:none"></div>
            <div style="display:flex;gap:8px;margin-top:12px">
              <button id="importBtn" class="btn btn-primary" disabled>Importar productos</button>
              <button id="clearBtn" class="btn btn-ghost" style="display:none">Quitar archivo</button>
            </div>
            <div id="importResult" style="margin-top:14px"></div>
          </>
        ) : (
          <div class="notice accent">Tu rol es de solo lectura. Puedes exportar el inventario, pero no importar.</div>
        )}
      </div>
    </section>

    <section class="card">
      <div class="card-head">
        <div><h3 class="card-title">Exportar inventario</h3><p class="card-sub">Archivo XML con todos los productos y un resumen</p></div>
      </div>
      <div class="card-body">
        <div class="export-meta" id="exportMeta">
          <div class="stat"><div class="k">Productos</div><div class="v" data-m="n"><span class="skeleton" style="width:40px;height:18px"></span></div></div>
          <div class="stat"><div class="k">Categorías</div><div class="v" data-m="c"><span class="skeleton" style="width:30px;height:18px"></span></div></div>
          <div class="stat"><div class="k">Stock bajo</div><div class="v" data-m="l"><span class="skeleton" style="width:30px;height:18px"></span></div></div>
        </div>
        <ul class="checklist">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Nombre, SKU, categoría, precio, existencia y mínimo de cada producto</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Resumen con valor total y conteo de stock bajo</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Compatible con la importación de esta misma pantalla</li>
        </ul>
        <button id="exportBtn" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m-5-5 5 5 5-5M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/></svg>
          Descargar XML
        </button>
      </div>
    </section>

    <section class="card full">
      <div class="card-head plain" style="padding-bottom:14px">
        <div><h3 class="card-title">Formato esperado</h3><p class="card-sub">Cada producto va dentro de &lt;productos&gt;. La categoría se asigna por nombre; si no existe, el producto queda sin categoría.</p></div>
      </div>
<pre class="code"><span class="c">&lt;?xml version="1.0" encoding="UTF-8"?&gt;</span>
<span class="t">&lt;inventario</span> <span class="a">version</span>=<span class="s">"1.0"</span> <span class="a">empresa</span>=<span class="s">"Ferretería del Centro"</span><span class="t">&gt;</span>
  <span class="t">&lt;productos&gt;</span>
    <span class="t">&lt;producto&gt;</span>
      <span class="t">&lt;nombre&gt;</span>Taladro percutor 1/2" 650 W<span class="t">&lt;/nombre&gt;</span>
      <span class="t">&lt;sku&gt;</span>HE-0201<span class="t">&lt;/sku&gt;</span>
      <span class="t">&lt;categoria&gt;</span>Herramientas eléctricas<span class="t">&lt;/categoria&gt;</span>
      <span class="t">&lt;precio&gt;</span>1849.00<span class="t">&lt;/precio&gt;</span>
      <span class="t">&lt;stock&gt;</span>8<span class="t">&lt;/stock&gt;</span>
      <span class="t">&lt;stockMinimo&gt;</span>3<span class="t">&lt;/stockMinimo&gt;</span>
      <span class="t">&lt;unidad&gt;</span>pza<span class="t">&lt;/unidad&gt;</span>
    <span class="t">&lt;/producto&gt;</span>
  <span class="t">&lt;/productos&gt;</span>
<span class="t">&lt;/inventario&gt;</span></pre>
    </section>
  </div>

  <script>
    import { esc, int, toast, icons } from '@/lib/ui';

    const FILE_IC = '<div class="drop-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6"/></svg></div>';

    // Metadatos de exportacion
    (async () => {
      try {
        const [p, c] = await Promise.all([fetch('/api/products').then(r => r.json()), fetch('/api/categories').then(r => r.json())]);
        const set = (k: string, v: string) => { const el = document.querySelector('[data-m="' + k + '"]'); if (el) el.textContent = v; };
        set('n', int(p.length));
        set('c', int(c.length));
        set('l', int(p.filter((x: any) => x.stock <= x.minStock).length));
      } catch { /* metadatos opcionales */ }
    })();

    document.getElementById('exportBtn')!.addEventListener('click', async () => {
      const btn = document.getElementById('exportBtn') as HTMLButtonElement;
      const html = btn.innerHTML;
      btn.disabled = true; btn.innerHTML = '<span class="spinner"></span>Generando...';
      try {
        const res = await fetch('/api/xml');
        if (!res.ok) throw new Error('Error ' + res.status);
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = res.headers.get('content-disposition')?.match(/filename="(.+)"/)?.[1] ?? 'inventario.xml';
        a.click(); URL.revokeObjectURL(url);
        toast('Archivo XML generado', 'success');
      } catch (err: any) { toast('No se pudo exportar: ' + err.message, 'error'); }
      finally { btn.disabled = false; btn.innerHTML = html; }
    });

    const input = document.getElementById('xmlFile') as HTMLInputElement | null;
    const drop = document.getElementById('dropZone');
    if (input && drop) {
      const importBtn = document.getElementById('importBtn') as HTMLButtonElement;
      const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
      const info = document.getElementById('fileInfo')!;
      const result = document.getElementById('importResult')!;
      let file: File | null = null;

      const setFile = (f: File | null) => {
        file = f;
        result.innerHTML = '';
        if (!f) {
          drop.style.display = ''; info.style.display = 'none'; clearBtn.style.display = 'none';
          importBtn.disabled = true; input.value = '';
          return;
        }
        if (!/\.xml$/i.test(f.name)) { toast('Selecciona un archivo con extensión .xml', 'error'); return setFile(null); }
        drop.style.display = 'none'; info.style.display = 'block'; clearBtn.style.display = '';
        info.innerHTML = '<div class="file-row">' + FILE_IC + '<div><b>' + esc(f.name) + '</b><span>' + (f.size / 1024).toFixed(1) + ' KB, listo para importar</span></div></div>';
        importBtn.disabled = false;
      };

      drop.addEventListener('click', () => input.click());
      drop.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
      input.addEventListener('change', () => setFile(input.files?.[0] ?? null));
      drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('over'));
      drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); setFile(e.dataTransfer?.files?.[0] ?? null); });
      clearBtn.addEventListener('click', () => setFile(null));

      importBtn.addEventListener('click', async () => {
        if (!file) return;
        importBtn.disabled = true; importBtn.innerHTML = '<span class="spinner"></span>Importando...';
        const form = new FormData(); form.append('file', file);
        try {
          const res = await fetch('/api/xml', { method: 'POST', body: form });
          const data = await res.json();
          if (res.ok && data.ok) {
            result.innerHTML =
              '<div class="notice success">' + icons.check + '<div><b>Importación completada.</b> ' + data.imported + ' productos nuevos agregados al catálogo.</div></div>' +
              '<div class="stats">' +
                '<div class="stat"><div class="k">Importados</div><div class="v" style="color:var(--success)">' + int(data.imported) + '</div></div>' +
                '<div class="stat"><div class="k">Omitidos (SKU existente)</div><div class="v">' + int(data.skipped) + '</div></div>' +
                '<div class="stat"><div class="k">En el archivo</div><div class="v">' + int(data.total) + '</div></div>' +
              '</div>' +
              '<div style="margin-top:12px"><a class="link" href="/productos">Ver productos</a></div>';
          } else {
            result.innerHTML = '<div class="notice danger">' + icons.alert + '<div><b>No se pudo importar.</b> ' + esc(data.error ?? 'Error desconocido') + '</div></div>';
          }
        } catch (err: any) {
          result.innerHTML = '<div class="notice danger">' + icons.alert + '<div>Error de conexión: ' + esc(err.message) + '</div></div>';
        } finally {
          importBtn.disabled = false; importBtn.textContent = 'Importar productos';
        }
      });
    }
  </script>
</Layout>

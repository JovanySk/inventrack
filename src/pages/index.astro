---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resumen" subtitle="Estado del inventario y actividad de los últimos 30 días">
  <style is:global>
    .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
    .kpi { padding: 16px; }
    .kpi-label { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--text-2); font-weight: 500; }
    .kpi-label svg { width: 15px; height: 15px; color: var(--text-3); }
    .kpi-value { margin-top: 10px; font-size: 26px; font-weight: 650; letter-spacing: -0.025em; font-variant-numeric: tabular-nums; line-height: 1.1; }
    .kpi-value small { font-size: 14px; font-weight: 500; color: var(--text-3); margin-left: 4px; letter-spacing: 0; }
    .kpi-foot { margin-top: 6px; font-size: 12px; color: var(--text-3); font-variant-numeric: tabular-nums; }
    .kpi-foot b { font-weight: 600; color: var(--text-2); }
    .kpi.warn .kpi-value { color: var(--warning); }

    .grid-a { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 16px; margin-bottom: 16px; }
    .grid-b { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
    .chart-box { position: relative; height: 240px; }
    .chart-box.sm { height: 168px; }
    .card.fill { display: flex; flex-direction: column; }
    .card.fill > .card-body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
    .card.fill .chart-box.grow { flex: 1; height: auto; min-height: 168px; }
    .legend { display: flex; gap: 14px; font-size: 12px; color: var(--text-2); }
    .legend i { display: inline-block; width: 10px; height: 3px; border-radius: 2px; margin-right: 6px; vertical-align: middle; }

    .low-list { list-style: none; margin: 0; padding: 4px 0; }
    .low-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: center; padding: 9px 16px; }
    .low-item + .low-item { border-top: 1px solid var(--border); }
    .low-name { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .low-sku { font-size: 11.5px; color: var(--text-3); font-family: var(--font-mono); }
    .low-qty { text-align: right; font-size: 13px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .low-min { font-size: 11.5px; color: var(--text-3); text-align: right; font-variant-numeric: tabular-nums; }
    .low-bar { grid-column: 1 / -1; height: 3px; background: var(--surface-3); border-radius: 99px; overflow: hidden; }
    .low-bar span { display: block; height: 100%; background: var(--warning); border-radius: 99px; }
    .low-bar span.out { background: var(--danger); }

    .donut-wrap { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 16px; align-items: center; }
    .donut-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font-size: 12px; }
    .donut-legend li { display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 8px; align-items: center; }
    .donut-legend .sw { width: 10px; height: 10px; border-radius: 3px; }
    .donut-legend .nm { color: var(--text-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .donut-legend .pc { color: var(--text); font-variant-numeric: tabular-nums; font-weight: 500; }

    .feed { list-style: none; margin: 0; padding: 4px 0; }
    .feed li { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px 16px; }
    .feed-ic { width: 26px; height: 26px; border-radius: 7px; display: grid; place-items: center; background: var(--surface-3); color: var(--text-2); }
    .feed-ic svg { width: 14px; height: 14px; }
    .feed-ic.in { background: var(--success-soft); color: var(--success); }
    .feed-ic.adj { background: var(--accent-soft); color: var(--accent-text); }
    .feed-name { font-size: 12.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .feed-sub { font-size: 11.5px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .feed-qty { font-size: 12.5px; text-align: right; }

    .fx { font-size: 12px; color: var(--text-3); }

    @media (max-width: 1180px) {
      .grid-b { grid-template-columns: 1fr 1fr; }
      .grid-b > :last-child { grid-column: 1 / -1; }
    }
    @media (max-width: 900px) {
      .kpis { grid-template-columns: 1fr 1fr; }
      .grid-a, .grid-b { grid-template-columns: minmax(0, 1fr); }
      .grid-b > :last-child { grid-column: auto; }
      .kpi-value { font-size: 22px; }
    }
  </style>

  <div id="dash" aria-busy="true">
    <div class="kpis">
      {[1, 2, 3, 4].map(() => (
        <div class="card kpi"><span class="skeleton" style="width:50%"></span><span class="skeleton" style="width:70%;height:24px;margin-top:14px"></span></div>
      ))}
    </div>
    <div class="grid-a">
      <div class="card" style="height:310px"></div>
      <div class="card" style="height:310px"></div>
    </div>
  </div>

  <template id="tpl">
    <div class="kpis">
      <div class="card kpi">
        <div class="kpi-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>Valor del inventario</div>
        <div class="kpi-value" data-k="value"></div>
        <div class="kpi-foot" data-k="valueFoot"></div>
      </div>
      <div class="card kpi">
        <div class="kpi-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8m18 0v8l-9 5m9-13-9 5m0 8V13m0 8-9-5V8l9 5"/></svg>Productos activos</div>
        <div class="kpi-value" data-k="products"></div>
        <div class="kpi-foot" data-k="productsFoot"></div>
      </div>
      <div class="card kpi" data-k="lowCard">
        <div class="kpi-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>Bajo el mínimo</div>
        <div class="kpi-value" data-k="low"></div>
        <div class="kpi-foot" data-k="lowFoot"></div>
      </div>
      <div class="card kpi">
        <div class="kpi-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16M7 4 3 8m4-4 4 4m6 12V4m0 16 4-4m-4 4-4-4"/></svg>Movimientos, 30 días</div>
        <div class="kpi-value" data-k="moves"></div>
        <div class="kpi-foot" data-k="movesFoot"></div>
      </div>
    </div>

    <div class="grid-a">
      <section class="card fill">
        <div class="card-head plain">
          <div>
            <h3 class="card-title">Entradas y salidas</h3>
            <p class="card-sub">Unidades por día, últimos 30 días</p>
          </div>
          <div class="legend"><span><i style="background:var(--chart-1)"></i>Entradas</span><span><i style="background:var(--chart-2)"></i>Salidas</span></div>
        </div>
        <div class="card-body" style="padding-top:8px"><div class="chart-box grow"><canvas id="chartTrend" aria-label="Entradas y salidas por día" role="img"></canvas></div></div>
      </section>

      <section class="card">
        <div class="card-head">
          <div>
            <h3 class="card-title">Stock bajo</h3>
            <p class="card-sub" data-k="lowSub"></p>
          </div>
          <a href="/alertas" class="link">Ver alertas</a>
        </div>
        <div data-k="lowList"></div>
      </section>
    </div>

    <div class="grid-b">
      <section class="card fill">
        <div class="card-head plain">
          <div>
            <h3 class="card-title">Valor por categoría</h3>
            <p class="card-sub">Participación en el valor total</p>
          </div>
        </div>
        <div class="card-body">
          <div class="donut-wrap">
            <div class="chart-box sm" style="height:132px"><canvas id="chartDonut" aria-label="Valor por categoría" role="img"></canvas></div>
            <ul class="donut-legend" data-k="donutLegend"></ul>
          </div>
        </div>
      </section>

      <section class="card fill">
        <div class="card-head plain">
          <div>
            <h3 class="card-title">Productos por categoría</h3>
            <p class="card-sub">Número de artículos activos</p>
          </div>
        </div>
        <div class="card-body" style="padding-top:8px"><div class="chart-box sm grow"><canvas id="chartCat" aria-label="Productos por categoría" role="img"></canvas></div></div>
      </section>

      <section class="card">
        <div class="card-head">
          <div>
            <h3 class="card-title">Actividad reciente</h3>
            <p class="card-sub">Últimos movimientos registrados</p>
          </div>
          <a href="/movimientos" class="link">Ver todo</a>
        </div>
        <ul class="feed" data-k="feed"></ul>
      </section>
    </div>
  </template>

  <script>
    import Chart from 'chart.js/auto';
    import { esc, money, int, dateTime, stateHtml } from '@/lib/ui';

    const ICON_IN  = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-6 6 6-6 6 6"/></svg>';
    const ICON_OUT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14m6-6-6 6-6-6"/></svg>';
    const ICON_ADJ = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M12 4v16"/></svg>';

    const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    async function load() {
      const root = document.getElementById('dash')!;
      try {
        const res = await fetch('/api/dashboard');
        const data = await res.json();
        if (!res.ok || data.error) throw new Error(data.error || 'Respuesta inválida del servidor');
        render(root, data);
      } catch (err: any) {
        root.innerHTML = '<div class="card">' + stateHtml('error', 'No se pudo cargar el resumen', err.message) +
          '<div style="text-align:center;padding-bottom:24px"><button class="btn btn-secondary" id="retry">Reintentar</button></div></div>';
        document.getElementById('retry')?.addEventListener('click', () => location.reload());
      } finally {
        root.setAttribute('aria-busy', 'false');
      }
    }

    function render(root: HTMLElement, data: any) {
      const tpl = document.getElementById('tpl') as HTMLTemplateElement;
      root.innerHTML = '';
      root.appendChild(tpl.content.cloneNode(true));
      const k = (name: string) => root.querySelector('[data-k="' + name + '"]') as HTMLElement;
      const t = data.totals;

      const whole = Math.round(t.totalValue);
      k('value').innerHTML = esc(money(whole).replace(/\.00$/, '')) + '<small>MXN</small>';
      k('valueFoot').innerHTML = t.exchangeRate
        ? 'Aprox. <b>' + esc(Number(t.totalValueUsd).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 })) + '</b> a ' + esc(Number(t.exchangeRate).toFixed(2)) + ' MXN por USD'
        : 'Tipo de cambio no disponible';
      k('products').textContent = int(t.totalProducts);
      k('productsFoot').innerHTML = '<b>' + int(t.totalUnits) + '</b> unidades en ' + data.byCategory.length + ' categorías';
      k('low').textContent = int(t.lowStockCount);
      k('lowFoot').innerHTML = t.outOfStock > 0 ? '<b>' + t.outOfStock + '</b> sin existencia' : 'Ninguno sin existencia';
      if (t.lowStockCount > 0) k('lowCard').classList.add('warn');
      k('moves').textContent = int(data.last30.movimientos);
      k('movesFoot').innerHTML = '<b>' + int(data.last30.entradas) + '</b> unidades entraron, <b>' + int(data.last30.salidas) + '</b> salieron';

      // Low stock list
      const low = data.lowStock as any[];
      k('lowSub').textContent = low.length ? low.length + ' productos requieren reabastecimiento' : 'Todo dentro del rango';
      if (low.length === 0) {
        k('lowList').innerHTML = '<div class="state" style="padding:40px 16px"><div class="state-icon success"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div><div class="state-title">Sin alertas</div><div class="state-text">Todos los productos están por encima de su mínimo.</div></div>';
      } else {
        k('lowList').innerHTML = '<ul class="low-list">' + low.slice(0, 5).map(p => {
          const pct = Math.min(100, (p.stock / Math.max(1, p.minStock)) * 100);
          return '<li class="low-item">' +
            '<div style="min-width:0"><div class="low-name">' + esc(p.name) + '</div><div class="low-sku">' + esc(p.sku || 'Sin SKU') + '</div></div>' +
            '<div><div class="low-qty" style="color:' + (p.stock === 0 ? 'var(--danger)' : 'var(--warning)') + '">' + p.stock + ' ' + esc(p.unit) + '</div><div class="low-min">mín. ' + p.minStock + '</div></div>' +
            '<div class="low-bar" title="' + Math.round(pct) + '% del mínimo"><span style="width:' + pct + '%"></span></div>' +
          '</li>';
        }).join('') + '</ul>' +
        (low.length > 5 ? '<div class="card-foot"><span>' + (low.length - 5) + ' más</span><a class="link" href="/alertas">Ver todos</a></div>' : '');
      }

      // Feed
      const feed = (data.recentMovements as any[]).slice(0, 5);
      k('feed').innerHTML = feed.length === 0
        ? '<li style="display:block">' + stateHtml('empty', 'Sin movimientos', 'Registra una entrada o salida desde Productos.') + '</li>'
        : feed.map(m => {
          const cls = m.type === 'entrada' ? 'in' : m.type === 'ajuste' ? 'adj' : '';
          const ic = m.type === 'entrada' ? ICON_IN : m.type === 'ajuste' ? ICON_ADJ : ICON_OUT;
          const qty = m.type === 'entrada' ? '<span class="qty-in">+' + m.quantity + '</span>'
            : m.type === 'ajuste' ? '<span class="qty-adj">=' + m.quantity + '</span>'
            : '<span class="qty-out">-' + m.quantity + '</span>';
          return '<li><span class="feed-ic ' + cls + '">' + ic + '</span>' +
            '<div style="min-width:0"><div class="feed-name">' + esc(m.productName || 'Producto eliminado') + '</div><div class="feed-sub">' + esc(m.reason || m.type) + ' · ' + esc(dateTime(m.createdAt)) + '</div></div>' +
            '<div class="feed-qty">' + qty + '</div></li>';
        }).join('');

      drawCharts(data, k);
    }

    function drawCharts(data: any, k: (n: string) => HTMLElement) {
      const grid = css('--chart-grid');
      const tick = css('--chart-tick');
      const palette = [1, 2, 3, 4, 5, 6, 7].map(i => css('--chart-' + i));
      const font = { family: css('--font-sans'), size: 11 };
      Chart.defaults.font = font as any;
      Chart.defaults.color = tick;

      const tooltip = {
        backgroundColor: css('--text'), titleColor: css('--bg'), bodyColor: css('--bg'),
        padding: 10, cornerRadius: 6, displayColors: true, boxWidth: 8, boxHeight: 8, boxPadding: 4,
        titleFont: { ...font, weight: 600 } as any, bodyFont: font as any,
      };

      // 1. Trend
      const daily = data.daily as any[];
      const labels = daily.map(d => {
        const [y, m, dd] = d.day.split('-').map(Number);
        return new Date(y, m - 1, dd).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).replace('.', '');
      });
      new Chart(document.getElementById('chartTrend') as HTMLCanvasElement, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'Entradas', data: daily.map(d => d.entradas), backgroundColor: palette[0], borderRadius: 3, maxBarThickness: 10, categoryPercentage: 0.7, barPercentage: 0.9 },
            { label: 'Salidas',  data: daily.map(d => d.salidas),  backgroundColor: palette[1], borderRadius: 3, maxBarThickness: 10, categoryPercentage: 0.7, barPercentage: 0.9 },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false, animation: false,
          interaction: { mode: 'index', intersect: false },
          plugins: { legend: { display: false }, tooltip: { ...tooltip, callbacks: { label: (c: any) => ' ' + c.dataset.label + ': ' + int(c.parsed.y) + ' u.' } } },
          scales: {
            x: { grid: { display: false }, border: { display: false }, ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 8 } },
            y: { beginAtZero: true, grid: { color: grid }, border: { display: false }, ticks: { maxTicksLimit: 5, precision: 0 } },
          },
        },
      });

      // 2. Donut: value per category
      const cats = data.byCategory as any[];
      const total = cats.reduce((s, c) => s + c.value, 0) || 1;
      new Chart(document.getElementById('chartDonut') as HTMLCanvasElement, {
        type: 'doughnut',
        data: {
          labels: cats.map(c => c.categoryName || 'Sin categoría'),
          datasets: [{ data: cats.map(c => c.value), backgroundColor: cats.map((_, i) => palette[i % palette.length]), borderColor: css('--surface'), borderWidth: 2, hoverOffset: 4 }],
        },
        options: {
          responsive: true, maintainAspectRatio: false, cutout: '68%', animation: false,
          plugins: { legend: { display: false }, tooltip: { ...tooltip, callbacks: { label: (c: any) => ' ' + money(c.parsed) } } },
        },
      });
      k('donutLegend').innerHTML = cats.map((c, i) =>
        '<li><span class="sw" style="background:' + palette[i % palette.length] + '"></span><span class="nm">' + esc(c.categoryName || 'Sin categoría') + '</span><span class="pc">' + Math.round((c.value / total) * 100) + '%</span></li>'
      ).join('');

      // 3. Horizontal bar: products per category
      const byCount = [...cats].sort((a, b) => b.count - a.count);
      new Chart(document.getElementById('chartCat') as HTMLCanvasElement, {
        type: 'bar',
        data: {
          labels: byCount.map(c => c.categoryName || 'Sin categoría'),
          datasets: [{ label: 'Productos', data: byCount.map(c => c.count), backgroundColor: palette[0], borderRadius: 3, barThickness: 12 }],
        },
        options: {
          indexAxis: 'y', responsive: true, maintainAspectRatio: false, animation: false,
          plugins: { legend: { display: false }, tooltip },
          scales: {
            x: { beginAtZero: true, grid: { color: grid }, border: { display: false }, ticks: { precision: 0, maxTicksLimit: 5 } },
            y: { grid: { display: false }, border: { display: false }, ticks: { color: css('--text-2'), autoSkip: false } },
          },
        },
      });
    }

    load();
  </script>
</Layout>

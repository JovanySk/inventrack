---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resumen" heading={false}>
  <style is:global>
    /* ── Carrusel ─────────────────────────────────────── */
    .hero { position: relative; height: 380px; overflow: hidden; background: #fff; touch-action: pan-y; }
    .hero:focus-visible { outline-offset: 4px; }
    .slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .6s var(--ease), visibility .6s; }
    .slide.is-active { opacity: 1; visibility: visible; z-index: 1; }
    .slide-media, .slide-bg { transform: translateX(72px); opacity: 0; transition: transform .6s var(--ease) .08s, opacity .6s var(--ease) .08s; }
    .slide.is-active .slide-media, .slide.is-active .slide-bg { transform: none; opacity: 1; }
    .slide-copy { position: relative; z-index: 2; padding: 62px 48px 0; max-width: 640px; }
    .slide-eyebrow { font: 700 12.5px/1 var(--font-sans); letter-spacing: .2em; text-transform: uppercase; }
    .slide-title { margin: 20px 0 14px; font: 800 clamp(38px, 4.6vw, 64px)/.95 var(--font-display); text-transform: uppercase; letter-spacing: -0.01em; }
    .slide-text { margin: 0 0 22px; font-size: 17px; font-weight: 600; }

    .slide-store { background: var(--yellow); }
    .slide-store .slide-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right center; }

    .slide-panel { position: absolute; left: 0; top: 0; bottom: 0; width: 52%; clip-path: polygon(0 0, 100% 0, 85% 100%, 0 100%); z-index: 2; }
    .slide-panel .slide-copy { padding-right: 90px; }
    .slide-restock .slide-panel { background: var(--yellow); }
    .slide-top .slide-panel { background: var(--ink); color: #fff; }
    .slide-top .slide-eyebrow { color: var(--yellow); }
    .slide-media { position: absolute; top: 0; bottom: 0; right: 0; width: 52%; display: grid; place-items: center; }
    .slide-media img { max-height: 300px; max-width: 80%; object-fit: contain; }
    .seal {
      position: absolute; top: 34px; right: 40px; width: 104px; height: 104px; border-radius: 50%;
      display: grid; place-content: center; text-align: center; background: var(--red); color: #fff;
      font: 800 30px/1 var(--font-display); text-transform: uppercase; transform: rotate(-8deg);
    }
    .seal small { display: block; margin-top: 4px; font: 700 10.5px/1 var(--font-sans); letter-spacing: .14em; }
    .seal.low { background: var(--ink); color: var(--yellow); }

    .hero-dots { position: absolute; z-index: 3; left: 48px; bottom: 30px; display: flex; gap: 6px; }
    .hero-dots button { width: 10px; height: 5px; padding: 0; border: 0; background: rgba(20,20,20,.3); cursor: pointer; transition: width .3s var(--ease), background-color .3s; }
    .hero-dots button[aria-current="true"] { width: 36px; background: var(--ink); }
    .hero[data-theme="dark"] .hero-dots button { background: rgba(255,255,255,.35); }
    .hero[data-theme="dark"] .hero-dots button[aria-current="true"] { background: var(--yellow); }
    .hero-arrows { position: absolute; z-index: 3; right: 20px; bottom: 20px; display: flex; gap: 6px; }
    .hero-arrows button { width: 40px; height: 40px; border: 0; background: var(--ink); color: var(--yellow); display: grid; place-items: center; cursor: pointer; transition: background-color .15s; }
    .hero-arrows button:hover { background: var(--ink-2); }
    .hero-arrows svg { width: 18px; height: 18px; }

    /* ── KPIs ──────────────────────────────────────────── */
    .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 28px; }
    .kpi { background: #fff; border-top: 6px solid var(--yellow); padding: 22px 22px 18px; box-shadow: var(--shadow-xs); }
    .kpi.alert { border-top-color: var(--red); }
    .kpi-label { font: 700 12px/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--steel); }
    .kpi-value { margin-top: 14px; font: 800 50px/1 var(--font-display); letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
    .kpi.alert .kpi-value { color: var(--red); }
    .kpi-foot { margin-top: 10px; font-size: 14px; color: var(--steel); }

    /* ── Pasillos ──────────────────────────────────────── */
    .aisles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
    .aisle { display: block; background: var(--yellow); padding: 8px 8px 12px; color: var(--ink); text-decoration: none; text-align: center; transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
    .aisle:hover { transform: translateY(-4px); box-shadow: var(--shadow-hard); }
    .aisle-img { display: grid; place-items: center; height: 150px; background: #fff; margin-bottom: 12px; overflow: hidden; }
    .aisle-img img { max-height: 130px; object-fit: contain; transition: transform .35s var(--ease); }
    .aisle:hover .aisle-img img { transform: scale(1.06); }
    .aisle b { display: block; font: 700 14.5px/1.2 var(--font-sans); letter-spacing: .04em; text-transform: uppercase; }
    .aisle span { display: block; margin-top: 4px; font-size: 13px; }

    /* ── Pestañas ──────────────────────────────────────── */
    .tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .tabs button {
      height: 36px; padding: 0 16px; border: 1px solid var(--border-strong); background: #fff; color: var(--ink);
      font: 700 13px/1 var(--font-sans); letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background-color .15s, border-color .15s;
    }
    .tabs button:hover { border-color: var(--ink); }
    .tabs button[aria-selected="true"] { background: var(--yellow); border-color: var(--yellow); }
    .pgrid.five { --cols: 5; }
    .pgrid.five .pcard-price { font-size: 30px; }

    /* ── Entradas y salidas + ticket ───────────────────── */
    .bottom-grid { display: grid; grid-template-columns: minmax(0, 1.52fr) minmax(0, 1fr); gap: 20px; margin-top: 28px; align-items: stretch; }
    .chart-panel { background: var(--ink); color: #fff; padding: 28px 28px 20px; display: flex; flex-direction: column; min-height: 330px; }
    .chart-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
    .chart-title { margin: 0; font: 800 34px/1 var(--font-display); text-transform: uppercase; color: var(--yellow); }
    .chart-sub { margin: 6px 0 0; color: var(--steel-light); font-size: 14px; }
    .chart-legend { display: flex; gap: 22px; font-size: 13px; font-weight: 600; }
    .chart-legend i { display: inline-block; width: 10px; height: 10px; margin-right: 6px; vertical-align: -1px; }
    .chart-box { position: relative; flex: 1; min-height: 210px; margin-top: 18px; }

    .ticket { background: #fff; border: 2px dashed var(--ink); padding: 22px 24px; font-family: var(--font-mono); display: flex; flex-direction: column; }
    .ticket-head { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; font-weight: 700; margin-bottom: 10px; }
    .ticket ol { list-style: none; margin: 0; padding: 0; }
    .ticket li { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 7px 0; }
    .ticket li + li { border-top: 1px dotted var(--border-strong); }
    .ticket time { font-size: 12.5px; color: var(--steel); }
    .ticket .t-name { font: 500 15px/1.2 var(--font-sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ticket .t-sub { font: 400 12.5px/1.3 var(--font-sans); color: var(--steel); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ticket .t-qty { font: 800 26px/1 var(--font-display); font-variant-numeric: tabular-nums; }
    .ticket .t-qty.in { color: var(--green); }
    .ticket .t-qty.adj { color: var(--gold-text); }
    .ticket-foot { margin-top: auto; padding-top: 14px; border-top: 2px dashed var(--ink); display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; }
    .ticket-foot a { color: var(--ink); font-weight: 700; }

    @media (max-width: 1100px) {
      .aisles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .pgrid.five { --cols: 3; }
      .bottom-grid { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 860px) {
      .hero { height: 500px; }
      .slide-copy { padding: 28px 20px 0; }
      .slide-title { margin: 12px 0 10px; font-size: 38px; }
      .slide-text { font-size: 15px; margin-bottom: 16px; }
      .slide-store .slide-bg { top: auto; height: 210px; object-position: 78% 60%; }
      .slide-panel { width: 100%; bottom: auto; height: 300px; clip-path: polygon(0 0, 100% 0, 100% 86%, 0 100%); }
      .slide-panel .slide-copy { padding-right: 20px; }
      .slide-media { top: auto; height: 210px; width: 100%; }
      .slide-media img { max-height: 180px; }
      .seal { top: auto; bottom: 110px; right: 18px; width: 84px; height: 84px; font-size: 24px; }
      .hero-dots { left: 20px; bottom: 18px; }
      .hero-arrows { right: 12px; bottom: 12px; }
      .hero[data-theme="dark"] .hero-dots button { background: rgba(20,20,20,.3); }
      .hero[data-theme="dark"] .hero-dots button[aria-current="true"] { background: var(--ink); }
      .kpis { grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
      .kpi { padding: 16px 14px 14px; }
      .kpi-value { font-size: 34px; }
      .kpi-label { font-size: 11px; letter-spacing: .1em; }
      .kpi-foot { font-size: 12.5px; }
      .aisles { display: flex; overflow-x: auto; gap: 12px; scroll-snap-type: x mandatory; padding-bottom: 6px; }
      .aisle { flex: 0 0 62%; scroll-snap-align: start; }
      .tabs { flex-wrap: nowrap; overflow-x: auto; width: 100%; scrollbar-width: none; gap: 6px; }
      .tabs button { flex: 0 0 auto; padding: 0 12px; font-size: 12px; }
      .pgrid.five { --cols: 2; }
      .pgrid.five .pcard-price { font-size: 24px; }
      .chart-panel { padding: 20px 16px; }
      .chart-title { font-size: 28px; }
      .ticket { padding: 18px 16px; }
    }
  </style>

  <div id="dash" aria-busy="true">
    <div class="hero" style="background:var(--surface-3)"></div>
    <div class="kpis">
      {[1, 2, 3, 4].map(() => (
        <div class="kpi"><span class="skeleton" style="width:50%"></span><span class="skeleton" style="width:70%;height:40px;margin-top:14px"></span></div>
      ))}
    </div>
  </div>

  <template id="tpl">
    <section class="hero" id="hero" tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Destacados de la bodega">
      <div data-k="slides"></div>
      <div class="hero-dots" data-k="dots"></div>
      <div class="hero-arrows">
        <button type="button" data-dir="-1" aria-label="Diapositiva anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="m15 5-7 7 7 7"/></svg></button>
        <button type="button" data-dir="1" aria-label="Diapositiva siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="m9 5 7 7-7 7"/></svg></button>
      </div>
    </section>

    <div class="kpis">
      <div class="kpi"><div class="kpi-label">Valor del inventario</div><div class="kpi-value" data-k="value"></div><div class="kpi-foot" data-k="valueFoot"></div></div>
      <div class="kpi"><div class="kpi-label">Productos activos</div><div class="kpi-value" data-k="products"></div><div class="kpi-foot" data-k="productsFoot"></div></div>
      <div class="kpi" data-k="lowCard"><div class="kpi-label">Bajo el mínimo</div><div class="kpi-value" data-k="low"></div><div class="kpi-foot" data-k="lowFoot"></div></div>
      <div class="kpi"><div class="kpi-label">Movimientos 30 días</div><div class="kpi-value" data-k="moves"></div><div class="kpi-foot" data-k="movesFoot"></div></div>
    </div>

    <div class="sec-head">
      <h2 class="sec-title">Pasillos</h2>
      <a class="sec-link" href="/categorias" data-k="aisleLink">Ver los pasillos →</a>
    </div>
    <div class="aisles" data-k="aisles"></div>

    <div class="sec-head">
      <h2 class="sec-title">Productos por surtir</h2>
      <div class="tabs" role="tablist" aria-label="Lista de productos">
        <button type="button" role="tab" id="tab-low" aria-controls="tabPanel" aria-selected="true" data-tab="low">Stock bajo</button>
        <button type="button" role="tab" id="tab-top" aria-controls="tabPanel" aria-selected="false" data-tab="top" tabindex="-1">Más vendidos</button>
        <button type="button" role="tab" id="tab-recent" aria-controls="tabPanel" aria-selected="false" data-tab="recent" tabindex="-1">Entradas recientes</button>
      </div>
    </div>
    <div class="pgrid five" id="tabPanel" role="tabpanel" aria-labelledby="tab-low" data-k="cards"></div>

    <div class="bottom-grid">
      <section class="chart-panel">
        <div class="chart-head">
          <div>
            <h2 class="chart-title">Entradas y salidas</h2>
            <p class="chart-sub">Unidades por día · últimos 30 días</p>
          </div>
          <div class="chart-legend"><span><i style="background:#fff"></i>Entradas</span><span style="color:var(--yellow)"><i style="background:var(--yellow)"></i>Salidas</span></div>
        </div>
        <div class="chart-box"><canvas id="chartTrend" role="img" aria-label="Entradas y salidas por día, últimos 30 días"></canvas></div>
      </section>

      <section class="ticket" aria-label="Últimos movimientos">
        <div class="ticket-head" data-k="ticketHead">Ticket · Últimos movimientos</div>
        <ol data-k="ticket"></ol>
        <div class="ticket-foot"><span data-k="ticketTotal"></span><a href="/movimientos">Ver historial</a></div>
      </section>
    </div>
  </template>

  <script>
    import Chart from 'chart.js/auto';
    import { esc, money, int, stateHtml, observeBars, countUp, reducedMotion } from '@/lib/ui';
    import { productCardHtml, type CardProduct } from '@/lib/cards';
    import { buildSlides, wrapIndex, sortByUrgency, stockLevel, productImage, categoryImage, BANNER_IMG, aisleLabel, unitLabel, type Slide } from '@/lib/catalog';

    const wholeMoney = (n: number) => money(Math.round(n)).replace(/\.00$/, '');

    async function load() {
      const root = document.getElementById('dash')!;
      try {
        const [dRes, pRes] = await Promise.all([fetch('/api/dashboard'), fetch('/api/products')]);
        const data = await dRes.json();
        const products = await pRes.json();
        if (!dRes.ok || data.error) throw new Error(data.error || 'Respuesta inválida del servidor');
        if (!pRes.ok) throw new Error(products.error || 'No se pudieron leer los productos');
        render(root, data, products);
      } catch (err: any) {
        root.innerHTML = '<div class="card">' + stateHtml('error', 'No se pudo cargar el resumen', err.message) +
          '<div style="text-align:center;padding-bottom:24px"><button class="btn btn-secondary" id="retry">Reintentar</button></div></div>';
        document.getElementById('retry')?.addEventListener('click', () => location.reload());
      } finally {
        root.setAttribute('aria-busy', 'false');
      }
    }

    function render(root: HTMLElement, data: any, products: any[]) {
      const tpl = document.getElementById('tpl') as HTMLTemplateElement;
      root.innerHTML = '';
      root.appendChild(tpl.content.cloneNode(true));
      const k = (name: string) => root.querySelector('[data-k="' + name + '"]') as HTMLElement;
      const t = data.totals;
      const cats = (data.byCategory as any[]).filter(c => c.categoryId).sort((a, b) => a.categoryId - b.categoryId);
      const prods: CardProduct[] = products.map(p => ({ ...p, price: Number(p.price) }));

      // ── Carrusel con datos reales ──
      const slides = buildSlides({
        totals: { totalProducts: t.totalProducts, totalValue: t.totalValue, totalUnits: t.totalUnits },
        categoryCount: cats.length,
        lowStock: prods.map(p => ({ ...p, soldWeek: (p as any).unitsOut7 })),
        topSellers: prods.map(p => ({ ...p, unitsOut: (p as any).unitsOut30 ?? 0 })),
      });
      setupCarousel(root.querySelector('#hero') as HTMLElement, slides);

      // ── KPIs ──
      countUp(k('value'), t.totalValue, wholeMoney);
      k('valueFoot').textContent = 'MXN en ' + int(t.totalUnits) + ' unidades' +
        (t.exchangeRate ? ' · aprox. ' + Number(t.totalValueUsd).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }) + ' USD' : '');
      countUp(k('products'), t.totalProducts, n => int(Math.round(n)));
      k('productsFoot').textContent = 'en ' + cats.length + ' pasillos';
      countUp(k('low'), t.lowStockCount, n => int(Math.round(n)));
      k('lowFoot').textContent = t.outOfStock === 1 ? '1 agotado' : t.outOfStock + ' agotados';
      if (t.lowStockCount > 0) k('lowCard').classList.add('alert');
      countUp(k('moves'), data.last30.movimientos, n => int(Math.round(n)));
      k('movesFoot').textContent = int(data.last30.entradas) + ' entran · ' + int(data.last30.salidas) + ' salen';

      // ── Pasillos ──
      k('aisleLink').textContent = 'Ver los ' + cats.length + ' pasillos →';
      k('aisles').innerHTML = cats.slice(0, 5).map(c =>
        '<a class="aisle" href="/productos?pasillo=' + c.categoryId + '">' +
          '<div class="aisle-img"><img src="' + esc(categoryImage(c.categoryName)) + '" alt="" loading="lazy"></div>' +
          '<b>' + esc(c.categoryName) + '</b>' +
          '<span>' + c.count + ' productos · ' + esc(wholeMoney(c.value)) + '</span>' +
        '</a>').join('');

      // ── Tarjetas con pestañas ──
      const lists: Record<string, () => string> = {
        low: () => {
          const low = sortByUrgency(prods.filter(p => stockLevel(p) !== 'ok')).slice(0, 5);
          return low.length ? low.map(p => productCardHtml(p)).join('')
            : '<div class="card" style="grid-column:1/-1">' + stateHtml('empty', 'Todo surtido', 'Ningún producto está en o bajo su mínimo.') + '</div>';
        },
        top: () => [...prods].filter((p: any) => p.unitsOut30 > 0).sort((a: any, b: any) => b.unitsOut30 - a.unitsOut30).slice(0, 5)
          .map((p: any, i) => productCardHtml(p, { badge: { text: i === 0 ? 'Más vendido' : '-' + p.unitsOut30 + ' en 30 días', cls: 'badge-ink' } })).join(''),
        recent: () => [...prods].filter((p: any) => p.lastEntryAt).sort((a: any, b: any) => +new Date(b.lastEntryAt) - +new Date(a.lastEntryAt)).slice(0, 5)
          .map((p: any) => productCardHtml(p, { badge: { text: 'Nuevo +' + (p.lastEntryQty ?? 0), cls: 'badge-accent' } })).join(''),
      };
      const tabs = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
      const panel = k('cards');
      const show = (name: string) => {
        tabs.forEach(b => { const on = b.dataset.tab === name; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; if (on) panel.setAttribute('aria-labelledby', b.id); });
        panel.innerHTML = lists[name]();
        observeBars(panel);
      };
      tabs.forEach((b, i) => {
        b.addEventListener('click', () => show(b.dataset.tab!));
        b.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          const next = tabs[wrapIndex(i + (e.key === 'ArrowRight' ? 1 : -1), tabs.length)];
          next.focus(); show(next.dataset.tab!);
        });
      });
      show('low');

      // ── Ticket ──
      const moves = (data.recentMovements as any[]).slice(0, 5);
      k('ticketHead').textContent = (moves[0] ? 'Ticket #' + String(moves[0].id).padStart(4, '0') + ' · ' : '') + 'Últimos movimientos';
      k('ticket').innerHTML = moves.length === 0 ? '<li style="display:block">Sin movimientos registrados.</li>' : moves.map(m => {
        const time = new Date(m.createdAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false });
        const cls = m.type === 'entrada' ? 'in' : m.type === 'ajuste' ? 'adj' : '';
        const sign = m.type === 'entrada' ? '+' : m.type === 'ajuste' ? '=' : '-';
        return '<li><time>' + esc(time) + '</time><div style="min-width:0"><div class="t-name">' + esc(m.productName || 'Producto eliminado') + '</div><div class="t-sub">' + esc(m.reason || m.type) + '</div></div>' +
          '<span class="t-qty ' + cls + '">' + sign + int(m.quantity) + '</span></li>';
      }).join('');
      const today = (data.daily as any[]).at(-1);
      k('ticketTotal').textContent = today ? 'Hoy: +' + int(today.entradas) + ' / -' + int(today.salidas) : '';

      drawChart(data.daily);
      observeBars(root);
    }

    // ── Carrusel ─────────────────────────────────────────
    function slideHtml(s: Slide, i: number, n: number): string {
      const label = ' role="group" aria-roledescription="diapositiva" aria-label="' + (i + 1) + ' de ' + n + '"';
      if (s.kind === 'store') {
        return '<div class="slide slide-store" data-theme="light"' + label + '>' +
          '<img class="slide-bg" src="' + BANNER_IMG + '" alt="" decoding="async">' +
          '<div class="slide-copy"><div class="slide-eyebrow">Bodega al día</div>' +
          '<h2 class="slide-title">Todo lo de tu<br>ferretería, contado</h2>' +
          '<p class="slide-text">' + int(s.products) + ' productos en ' + s.categories + ' pasillos · ' + esc(wholeMoney(s.value)) + ' en inventario</p>' +
          '<a class="btn btn-ink" href="/productos">Ver inventario</a></div></div>';
      }
      if (s.kind === 'restock') {
        const p = s.product;
        const unit = unitLabel(p.unit, 1).toUpperCase();
        const sealTxt = s.level === 'out' ? 'Agotado' : s.level === 'critical' ? 'Crítico' : 'Bajo';
        const sold = p.soldWeek ? 'se vendieron ' + int(p.soldWeek) + ' esta semana · ' : '';
        return '<div class="slide slide-restock" data-theme="light"' + label + '>' +
          '<div class="slide-panel"><div class="slide-copy"><div class="slide-eyebrow">Reabastecer hoy</div>' +
          '<h2 class="slide-title">' + esc(p.name) + '</h2>' +
          '<p class="slide-text">' + esc(p.sku || '') + ' · ' + sold + 'pedido sugerido ' + int(s.order) + ' ' + esc(unitLabel(p.unit, s.order)) + '</p>' +
          '<a class="btn btn-ink" href="/alertas">Generar orden · ' + esc(wholeMoney(s.cost)) + '</a></div></div>' +
          '<div class="slide-media"><img src="' + esc(productImage(p)) + '" alt="' + esc(p.name) + '" decoding="async"></div>' +
          '<span class="seal' + (s.level === 'low' ? ' low' : '') + '">' + int(p.stock) + ' ' + esc(unit) + '<small>' + sealTxt + '</small></span></div>';
      }
      const p = s.product;
      return '<div class="slide slide-top" data-theme="dark"' + label + '>' +
        '<div class="slide-panel"><div class="slide-copy"><div class="slide-eyebrow">Lo más vendido del mes</div>' +
        '<h2 class="slide-title">' + esc(p.name) + ' · ' + int(p.unitsOut) + ' vendidas</h2>' +
        '<p class="slide-text">Quedan ' + int(p.stock) + ' en el ' + esc(aisleLabel(p.categoryId).toLowerCase()) + (s.cover !== null ? ' · alcanza para ' + s.cover + (s.cover === 1 ? ' día' : ' días') : '') + '</p>' +
        '<a class="btn btn-primary" href="/productos?q=' + encodeURIComponent(p.sku || p.name) + '">Ver producto</a></div></div>' +
        '<div class="slide-media"><img src="' + esc(productImage(p)) + '" alt="' + esc(p.name) + '" decoding="async"></div></div>';
    }

    function setupCarousel(hero: HTMLElement, slides: Slide[]) {
      const wrap = hero.querySelector('[data-k="slides"]') as HTMLElement;
      const dots = hero.querySelector('[data-k="dots"]') as HTMLElement;
      wrap.innerHTML = slides.map((s, i) => slideHtml(s, i, slides.length)).join('');
      dots.innerHTML = slides.map((_, i) => '<button type="button" aria-label="Ir a la diapositiva ' + (i + 1) + '"></button>').join('');
      const els = wrap.querySelectorAll<HTMLElement>('.slide');
      const dotEls = dots.querySelectorAll<HTMLButtonElement>('button');
      let index = 0;
      let timer: number | undefined;
      let paused = false;
      const auto = !reducedMotion() && slides.length > 1;

      const go = (i: number) => {
        index = wrapIndex(i, slides.length);
        els.forEach((el, j) => { el.classList.toggle('is-active', j === index); el.setAttribute('aria-hidden', String(j !== index)); el.querySelectorAll('a').forEach(a => (a.tabIndex = j === index ? 0 : -1)); });
        dotEls.forEach((d, j) => d.setAttribute('aria-current', String(j === index)));
        hero.dataset.theme = els[index].dataset.theme;
        schedule();
      };
      const schedule = () => {
        window.clearTimeout(timer);
        if (auto && !paused && !document.hidden) timer = window.setTimeout(() => go(index + 1), 4000);
      };
      const pause = (v: boolean) => { paused = v; schedule(); };

      hero.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach(b => b.addEventListener('click', () => go(index + Number(b.dataset.dir))));
      dotEls.forEach((d, j) => d.addEventListener('click', () => go(j)));
      hero.addEventListener('mouseenter', () => pause(true));
      hero.addEventListener('mouseleave', () => pause(false));
      hero.addEventListener('focusin', () => pause(true));
      hero.addEventListener('focusout', (e) => { if (!hero.contains(e.relatedTarget as Node)) pause(false); });
      hero.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') go(index + 1);
        if (e.key === 'ArrowLeft') go(index - 1);
      });
      document.addEventListener('visibilitychange', schedule);

      // Deslizar en pantallas táctiles
      let startX = 0, startY = 0;
      hero.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; });
      hero.addEventListener('pointerup', (e) => {
        const dx = e.clientX - startX, dy = e.clientY - startY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
      });

      // Exponer para capturas y pruebas manuales
      (window as any).__carousel = { go, count: slides.length };
      go(0);
    }

    // ── Gráfica ──────────────────────────────────────────
    function drawChart(daily: any[]) {
      const font = { family: getComputedStyle(document.body).fontFamily, size: 11 };
      Chart.defaults.font = font as any;
      const labels = daily.map(d => {
        const [y, m, dd] = d.day.split('-').map(Number);
        return new Date(y, m - 1, dd).toLocaleDateString('es-MX', { day: 'numeric', month: 'short' }).replace('.', '').toUpperCase();
      });
      new Chart(document.getElementById('chartTrend') as HTMLCanvasElement, {
        type: 'bar',
        data: {
          labels,
          datasets: [
            { label: 'Entradas', data: daily.map(d => d.entradas), backgroundColor: '#FFFFFF', borderRadius: 0, maxBarThickness: 9, categoryPercentage: 0.75, barPercentage: 0.9 },
            { label: 'Salidas',  data: daily.map(d => d.salidas),  backgroundColor: '#FFC72C', borderRadius: 0, maxBarThickness: 9, categoryPercentage: 0.75, barPercentage: 0.9 },
          ],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          animation: reducedMotion() ? false : { duration: 700, easing: 'easeOutCubic' },
          animations: { x: { duration: 0 }, width: { duration: 0 } },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#FFC72C', titleColor: '#141414', bodyColor: '#141414', cornerRadius: 0, padding: 10, boxWidth: 8, boxHeight: 8,
              callbacks: { label: (c: any) => ' ' + c.dataset.label + ': ' + int(c.parsed.y) + ' u.' },
            },
          },
          scales: {
            x: { grid: { display: false }, border: { color: '#3A3A3A' }, ticks: { color: '#9AA1AA', maxRotation: 0, autoSkip: true, maxTicksLimit: 6 } },
            y: { display: false, beginAtZero: true },
          },
        },
      });
    }

    load();
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
<style is:global>
  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
  @media (max-width: 900px) { .kpi-grid { grid-template-columns: repeat(2,1fr); } }

  .kpi-card {
    border-radius: 14px; padding: 18px 20px;
    border: 1px solid; transition: transform 0.2s;
    cursor: default;
  }
  .kpi-card:hover { transform: translateY(-2px); }
  .kpi-label { font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.5; margin-bottom: 10px; }
  .kpi-row { display: flex; align-items: flex-end; gap: 10px; }
  .kpi-icon { font-size: 22px; line-height: 1; }
  .kpi-value { font-size: 26px; font-weight: 900; line-height: 1; letter-spacing: -0.5px; }
  .kpi-sub { font-size: 10px; margin-top: 6px; opacity: 0.45; }

  .kpi-pink  { background: rgba(236,72,153,0.07);  border-color: rgba(236,72,153,0.15);  color: #f472b6; }
  .kpi-cyan  { background: rgba(6,182,212,0.07);   border-color: rgba(6,182,212,0.15);   color: #22d3ee; }
  .kpi-amber { background: rgba(245,158,11,0.07);  border-color: rgba(245,158,11,0.15);  color: #fbbf24; }
  .kpi-red   { background: rgba(239,68,68,0.07);   border-color: rgba(239,68,68,0.15);   color: #f87171; }

  .exch-bar {
    display: flex; align-items: center; gap: 10px;
    padding: 11px 18px; border-radius: 12px; margin-bottom: 22px;
    background: rgba(6,182,212,0.05); border: 1px solid rgba(6,182,212,0.12);
    font-size: 12px; color: rgba(180,150,255,0.5);
  }
  .exch-bar strong { color: #22d3ee; font-family: monospace; font-size: 13px; }
  .exch-src { margin-left: auto; font-size: 10px; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }

  .panel {
    border-radius: 14px; border: 1px solid rgba(150,80,255,0.12);
    background: rgba(255,255,255,0.02); overflow: hidden;
  }
  .panel-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; border-bottom: 1px solid rgba(150,80,255,0.08);
  }
  .panel-title { font-size: 14px; font-weight: 700; color: #e2d9f3; }
  .panel-body { padding: 16px 18px; }

  .stock-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-radius: 10px; margin-bottom: 6px;
    background: rgba(255,255,255,0.02); border: 1px solid rgba(150,80,255,0.07);
    transition: background 0.15s;
  }
  .stock-item:hover { background: rgba(150,80,255,0.06); }
  .stock-item:last-child { margin-bottom: 0; }
  .stock-name { font-size: 13px; font-weight: 500; color: #e2d9f3; }
  .stock-sku  { font-size: 10px; font-family: monospace; color: rgba(180,150,255,0.4); margin-top: 1px; }
  .stock-qty  { text-align: right; }
  .stock-num  { font-size: 14px; font-weight: 700; }
  .stock-min  { font-size: 10px; color: rgba(180,150,255,0.35); }
  .no-issues { text-align: center; padding: 30px; font-size: 13px; color: rgba(180,150,255,0.35); }

  .badge-alert {
    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 99px;
    background: rgba(245,158,11,0.12); color: #fbbf24; border: 1px solid rgba(245,158,11,0.2);
  }
  .see-all { font-size: 11px; font-weight: 600; color: rgba(168,85,247,0.7); text-decoration: none; transition: color 0.2s; }
  .see-all:hover { color: #ec4899; }

  .mini-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .mini-table thead th {
    text-align: left; padding: 7px 10px;
    font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(180,150,255,0.35); border-bottom: 1px solid rgba(150,80,255,0.08);
  }
  .mini-table tbody td { padding: 9px 10px; border-bottom: 1px solid rgba(150,80,255,0.05); color: rgba(180,150,255,0.7); }
  .mini-table tbody tr:last-child td { border-bottom: none; }
  .mini-table tbody tr:hover td { background: rgba(150,80,255,0.04); }

  .badge-e { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(16,185,129,0.2); }
  .badge-s { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(248,113,113,0.12);color:#f87171;border:1px solid rgba(248,113,113,0.2); }
  .badge-a { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(96,165,250,0.12);color:#93c5fd;border:1px solid rgba(96,165,250,0.2); }

  .qty-in  { color:#34d399; font-weight:700; font-family:monospace; }
  .qty-out { color:#f87171; font-weight:700; font-family:monospace; }

  .btn-alert {
    width: 100%; margin-top: 14px; padding: 9px; border-radius: 10px; border: none;
    background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.2);
    color: rgba(168,85,247,0.8); font-size: 12px; font-family: 'Inter', sans-serif; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .btn-alert:hover { background: rgba(168,85,247,0.18); color: #e2d9f3; }
  .btn-alert svg { width: 13px; height: 13px; }

  .spin { display:flex; align-items:center; justify-content:center; height:200px; gap:12px; color:rgba(180,150,255,0.4); font-size:13px; }
  .spinner-ring {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid rgba(150,80,255,0.15);
    border-top-color: #a855f7;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .chart-canvas-wrap { position: relative; width: 100%; min-height: 220px; }
  .chart-canvas-wrap canvas { width: 100% !important; }
</style>

  <div id="dash">
    <div class="spin">
      <div class="spinner-ring"></div>
      Cargando...
    </div>
  </div>

  <!-- Cargar Chart.js PRIMERO -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

  <script is:inline>
    var _dashData = null;

    async function loadDashboard() {
      var root = document.getElementById('dash');
      try {
        var res  = await fetch('/api/dashboard');
        var data = await res.json();
        if (data.error) throw new Error(data.error);
        _dashData = data;
        var totals = data.totals;
        var byCategory = data.byCategory;
        var lowStock = data.lowStock;
        var recentMovements = data.recentMovements;

        function fmx(n) { return '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 2 }); }

        // KPIs
        var h = '<div class="kpi-grid">';
        h += kpi('📦','Total Productos', totals.totalProducts, 'pink', '');
        h += kpi('💰','Valor Inventario', fmx(totals.totalValue), 'cyan',
          totals.exchangeRate ? '≈ $' + Number(totals.totalValueUsd).toLocaleString('en-US') + ' USD' : '');
        h += kpi('⚠️','Stock Bajo', totals.lowStockCount, 'amber', '');
        h += kpi('🚫','Sin Stock', totals.outOfStock, 'red', '');
        h += '</div>';

        // Exchange rate
        if (totals.exchangeRate) {
          h += '<div class="exch-bar">';
          h += '<span>🌐</span>';
          h += '<span>Tipo de cambio en tiempo real</span>';
          h += '<strong>$1 USD = $' + totals.exchangeRate.toFixed(2) + ' MXN</strong>';
          h += '<span class="exch-src">via open.er-api.com</span>';
          h += '</div>';
        }

        // === ROW 1: Bar Chart + Low Stock ===
        h += '<div class="two-col">';

        // Bar chart panel
        h += '<div class="panel">';
        h += '<div class="panel-head">';
        h += '<span class="panel-title">Productos por Categoría</span>';
        h += '<span style="font-size:11px;color:rgba(180,150,255,0.4)">' + byCategory.length + ' categorías</span>';
        h += '</div>';
        h += '<div class="panel-body"><div class="chart-canvas-wrap"><canvas id="chartCat"></canvas></div></div>';
        h += '</div>';

        // Low stock panel
        h += '<div class="panel">';
        h += '<div class="panel-head">';
        h += '<span class="panel-title">Stock Bajo</span>';
        h += '<span class="badge-alert">' + lowStock.length + ' alerta' + (lowStock.length !== 1 ? 's' : '') + '</span>';
        h += '</div>';
        h += '<div class="panel-body">';
        if (lowStock.length === 0) {
          h += '<div class="no-issues">✅ Todo en orden</div>';
        } else {
          for (var i = 0; i < lowStock.length; i++) {
            var p = lowStock[i];
            var c = p.stock === 0 ? '#f87171' : '#fbbf24';
            h += '<div class="stock-item">';
            h += '<div><div class="stock-name">' + p.name + '</div><div class="stock-sku">' + (p.sku || 'Sin SKU') + '</div></div>';
            h += '<div class="stock-qty">';
            h += '<div class="stock-num" style="color:' + c + '">' + p.stock + ' ' + p.unit + '</div>';
            h += '<div class="stock-min">mín: ' + p.minStock + '</div>';
            h += '</div></div>';
          }
          h += '<button class="btn-alert" onclick="checkAlerts()">';
          h += '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>';
          h += 'Enviar alerta por email</button>';
        }
        h += '</div></div>';
        h += '</div>'; // close two-col

        // === ROW 2: Donut Chart + Line Chart ===
        h += '<div class="two-col">';

        // Donut chart
        h += '<div class="panel">';
        h += '<div class="panel-head">';
        h += '<span class="panel-title">Distribución de Valor</span>';
        h += '<span style="font-size:11px;color:rgba(180,150,255,0.4)">Valor total</span>';
        h += '</div>';
        h += '<div class="panel-body"><div class="chart-canvas-wrap"><canvas id="chartDonut"></canvas></div></div>';
        h += '</div>';

        // Line chart
        h += '<div class="panel">';
        h += '<div class="panel-head">';
        h += '<span class="panel-title">Tendencia de Movimientos</span>';
        h += '<span style="font-size:11px;color:rgba(180,150,255,0.4)">Últimos registros</span>';
        h += '</div>';
        h += '<div class="panel-body"><div class="chart-canvas-wrap"><canvas id="chartTrend"></canvas></div></div>';
        h += '</div>';

        h += '</div>'; // close two-col

        // === Recent movements table ===
        h += '<div class="panel">';
        h += '<div class="panel-head">';
        h += '<span class="panel-title">Últimos Movimientos</span>';
        h += '<a href="/movimientos" class="see-all">Ver todos →</a>';
        h += '</div>';
        h += '<div style="overflow-x:auto">';
        h += '<table class="mini-table"><thead><tr>';
        h += '<th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Stock</th><th>Razón</th><th>Fecha</th>';
        h += '</tr></thead><tbody>';

        for (var j = 0; j < recentMovements.length; j++) {
          var m = recentMovements[j];
          var badge = m.type === 'entrada'
            ? '<span class="badge-e">↑ Entrada</span>'
            : m.type === 'salida'
            ? '<span class="badge-s">↓ Salida</span>'
            : '<span class="badge-a">⊙ Ajuste</span>';
          var qty = '<span class="' + (m.type === 'salida' ? 'qty-out' : 'qty-in') + '">' + (m.type === 'salida' ? '−' : '+') + m.quantity + '</span>';
          h += '<tr>';
          h += '<td style="color:#e2d9f3;font-weight:500">' + (m.productName || '—') + '</td>';
          h += '<td>' + badge + '</td>';
          h += '<td>' + qty + '</td>';
          h += '<td style="font-family:monospace;font-weight:600;color:#e2d9f3">' + m.newStock + '</td>';
          h += '<td>' + (m.reason || '—') + '</td>';
          h += '<td style="font-size:10px;white-space:nowrap">' + new Date(m.createdAt).toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'}) + '</td>';
          h += '</tr>';
        }

        h += '</tbody></table></div></div>';

        root.innerHTML = h;

        // Esperar un frame para que el DOM se renderice y luego crear charts
        setTimeout(function() { createCharts(data); }, 100);

      } catch (err) {
        root.innerHTML =
          '<div style="text-align:center;padding:60px;color:rgba(180,150,255,0.4)">' +
          '<p style="font-size:32px;margin-bottom:10px">💥</p>' +
          '<p style="font-weight:700;color:#f87171">Error cargando dashboard</p>' +
          '<p style="font-size:12px;margin-top:6px">' + err.message + '</p></div>';
      }
    }

    function createCharts(data) {
      if (typeof Chart === 'undefined') {
        console.warn('[Dashboard] Chart.js no disponible, reintentando...');
        setTimeout(function() { createCharts(data); }, 500);
        return;
      }

      var byCategory = data.byCategory;
      var recentMovements = data.recentMovements;

      var colors = [
        { bg:'rgba(236,72,153,0.45)',  border:'#ec4899' },
        { bg:'rgba(6,182,212,0.45)',   border:'#06b6d4' },
        { bg:'rgba(16,185,129,0.45)',  border:'#10b981' },
        { bg:'rgba(245,158,11,0.45)',  border:'#f59e0b' },
        { bg:'rgba(139,92,246,0.45)',  border:'#8b5cf6' },
        { bg:'rgba(244,63,94,0.45)',   border:'#f43f5e' },
        { bg:'rgba(99,102,241,0.45)',  border:'#6366f1' },
        { bg:'rgba(20,184,166,0.45)',  border:'#14b8a6' },
      ];

      // ═══ CHART 1: Bar - Productos por Categoría ═══
      var catCanvas = document.getElementById('chartCat');
      if (catCanvas) {
        new Chart(catCanvas.getContext('2d'), {
          type: 'bar',
          data: {
            labels: byCategory.map(function(c) { return c.categoryName || 'Sin categoría'; }),
            datasets: [{
              label: 'Productos',
              data: byCategory.map(function(c) { return c.count; }),
              backgroundColor: colors.map(function(c) { return c.bg; }),
              borderColor: colors.map(function(c) { return c.border; }),
              borderWidth: 2, borderRadius: 8, borderSkipped: false,
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, ticks: { stepSize: 1, color: 'rgba(180,150,255,0.35)' }, grid: { color: 'rgba(150,80,255,0.06)' }, border: { display: false } },
              x: { ticks: { color: 'rgba(180,150,255,0.5)' }, grid: { display: false }, border: { display: false } },
            },
          },
        });
        console.log('[Dashboard] ✅ Gráfica de barras creada');
      }

      // ═══ CHART 2: Donut - Distribución de Valor ═══
      var donutCanvas = document.getElementById('chartDonut');
      if (donutCanvas && byCategory.length > 0) {
        var donutLabels = [];
        var donutData = [];
        var donutColors = [];
        var donutBorders = [];

        for (var i = 0; i < byCategory.length; i++) {
          var cat = byCategory[i];
          var val = parseFloat(cat.totalValue) || (cat.count * 100);
          donutLabels.push(cat.categoryName || 'Sin categoría');
          donutData.push(val);
          donutColors.push(colors[i % colors.length].bg);
          donutBorders.push(colors[i % colors.length].border);
        }

        new Chart(donutCanvas.getContext('2d'), {
          type: 'doughnut',
          data: {
            labels: donutLabels,
            datasets: [{
              data: donutData,
              backgroundColor: donutColors,
              borderColor: donutBorders,
              borderWidth: 2,
              hoverOffset: 8,
            }],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '60%',
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: 'rgba(180,150,255,0.6)', padding: 12, font: { size: 11 }, usePointStyle: true, pointStyleWidth: 8 }
              },
            },
          },
        });
        console.log('[Dashboard] ✅ Gráfica de dona creada');
      }

      // ═══ CHART 3: Line - Tendencia de Movimientos ═══
      var trendCanvas = document.getElementById('chartTrend');
      if (trendCanvas && recentMovements.length > 0) {
        var trendLabels = [];
        var trendEntradas = [];
        var trendSalidas = [];

        // Agrupar movimientos por fecha
        var grouped = {};
        for (var k = recentMovements.length - 1; k >= 0; k--) {
          var mv = recentMovements[k];
          var dateKey = new Date(mv.createdAt).toLocaleDateString('es-MX', { day: '2-digit', month: 'short' });
          if (!grouped[dateKey]) { grouped[dateKey] = { entradas: 0, salidas: 0 }; }
          if (mv.type === 'entrada') { grouped[dateKey].entradas += mv.quantity; }
          else if (mv.type === 'salida') { grouped[dateKey].salidas += mv.quantity; }
        }

        var keys = Object.keys(grouped);
        for (var g = 0; g < keys.length; g++) {
          trendLabels.push(keys[g]);
          trendEntradas.push(grouped[keys[g]].entradas);
          trendSalidas.push(grouped[keys[g]].salidas);
        }

        new Chart(trendCanvas.getContext('2d'), {
          type: 'line',
          data: {
            labels: trendLabels,
            datasets: [
              {
                label: 'Entradas',
                data: trendEntradas,
                borderColor: '#34d399',
                backgroundColor: 'rgba(52,211,153,0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#34d399',
                pointRadius: 4,
              },
              {
                label: 'Salidas',
                data: trendSalidas,
                borderColor: '#f87171',
                backgroundColor: 'rgba(248,113,113,0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#f87171',
                pointRadius: 4,
              }
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { color: 'rgba(180,150,255,0.6)', padding: 12, font: { size: 11 }, usePointStyle: true }
              },
            },
            scales: {
              y: { beginAtZero: true, ticks: { color: 'rgba(180,150,255,0.35)' }, grid: { color: 'rgba(150,80,255,0.06)' }, border: { display: false } },
              x: { ticks: { color: 'rgba(180,150,255,0.5)' }, grid: { display: false }, border: { display: false } },
            },
          },
        });
        console.log('[Dashboard] ✅ Gráfica de tendencia creada');
      }
    }

    function kpi(icon, label, value, color, sub) {
      return '<div class="kpi-card kpi-' + color + '">' +
        '<p class="kpi-label">' + label + '</p>' +
        '<div class="kpi-row"><span class="kpi-icon">' + icon + '</span><span class="kpi-value">' + value + '</span></div>' +
        (sub ? '<p class="kpi-sub">' + sub + '</p>' : '') +
      '</div>';
    }

    function checkAlerts() {
      var btn = document.querySelector('.btn-alert');
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      fetch('/api/alerts', { method: 'POST' })
        .then(function(res) { return res.json(); })
        .then(function(data) { alert(data.message || 'Alerta procesada'); })
        .catch(function() { alert('Error al enviar'); })
        .finally(function() {
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Enviar alerta por email';
          }
        });
    }

    loadDashboard();
  </script>
</Layout>
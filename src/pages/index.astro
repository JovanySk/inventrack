---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard">
<style is:global>
  /* KPI Grid */
  .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 22px; }
  @media (max-width: 900px) { .kpi-grid { grid-template-columns: repeat(2,1fr); } }

  .kpi-card {
    border-radius: 14px; padding: 18px 20px;
    border: 1px solid; transition: transform 0.2s;
    cursor: default;
  }
  .kpi-card:hover { transform: translateY(-2px); }
  .kpi-label { font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.5; margin-bottom: 10px; }
  .kpi-row { display: flex; align-items: flex-end; gap: 10px; }
  .kpi-icon { font-size: 22px; line-height: 1; }
  .kpi-value { font-size: 26px; font-weight: 900; line-height: 1; letter-spacing: -0.5px; }
  .kpi-sub { font-size: 10px; margin-top: 6px; opacity: 0.45; }

  .kpi-pink  { background: rgba(236,72,153,0.07);  border-color: rgba(236,72,153,0.15);  color: #f472b6; }
  .kpi-cyan  { background: rgba(6,182,212,0.07);   border-color: rgba(6,182,212,0.15);   color: #22d3ee; }
  .kpi-amber { background: rgba(245,158,11,0.07);  border-color: rgba(245,158,11,0.15);  color: #fbbf24; }
  .kpi-red   { background: rgba(239,68,68,0.07);   border-color: rgba(239,68,68,0.15);   color: #f87171; }

  /* Exchange rate bar */
  .exch-bar {
    display: flex; align-items: center; gap: 10px;
    padding: 11px 18px; border-radius: 12px; margin-bottom: 22px;
    background: rgba(6,182,212,0.05); border: 1px solid rgba(6,182,212,0.12);
    font-size: 12px; color: rgba(180,150,255,0.5);
  }
  .exch-bar strong { color: #22d3ee; font-family: monospace; font-size: 13px; }
  .exch-src { margin-left: auto; font-size: 10px; }

  /* Two-column section */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }

  .panel {
    border-radius: 14px; border: 1px solid rgba(150,80,255,0.12);
    background: rgba(255,255,255,0.02); overflow: hidden;
  }
  .panel-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 18px; border-bottom: 1px solid rgba(150,80,255,0.08);
  }
  .panel-title { font-size: 14px; font-weight: 700; color: #e2d9f3; }
  .panel-body { padding: 16px 18px; }

  /* Low stock list */
  .stock-item {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 12px; border-radius: 10px; margin-bottom: 6px;
    background: rgba(255,255,255,0.02); border: 1px solid rgba(150,80,255,0.07);
    transition: background 0.15s;
  }
  .stock-item:hover { background: rgba(150,80,255,0.06); }
  .stock-item:last-child { margin-bottom: 0; }
  .stock-name { font-size: 13px; font-weight: 500; color: #e2d9f3; }
  .stock-sku  { font-size: 10px; font-family: monospace; color: rgba(180,150,255,0.4); margin-top: 1px; }
  .stock-qty  { text-align: right; }
  .stock-num  { font-size: 14px; font-weight: 700; }
  .stock-min  { font-size: 10px; color: rgba(180,150,255,0.35); }
  .no-issues { text-align: center; padding: 30px; font-size: 13px; color: rgba(180,150,255,0.35); }

  .badge-alert {
    font-size: 10px; font-weight: 700; padding: 3px 10px; border-radius: 99px;
    background: rgba(245,158,11,0.12); color: #fbbf24; border: 1px solid rgba(245,158,11,0.2);
  }
  .see-all { font-size: 11px; font-weight: 600; color: rgba(168,85,247,0.7); text-decoration: none; transition: color 0.2s; }
  .see-all:hover { color: #ec4899; }

  /* Mini table inside panel */
  .mini-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .mini-table thead th {
    text-align: left; padding: 7px 10px;
    font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: rgba(180,150,255,0.35); border-bottom: 1px solid rgba(150,80,255,0.08);
  }
  .mini-table tbody td { padding: 9px 10px; border-bottom: 1px solid rgba(150,80,255,0.05); color: rgba(180,150,255,0.7); }
  .mini-table tbody tr:last-child td { border-bottom: none; }
  .mini-table tbody tr:hover td { background: rgba(150,80,255,0.04); }

  .badge-e { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(16,185,129,0.12);color:#34d399;border:1px solid rgba(16,185,129,0.2); }
  .badge-s { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(248,113,113,0.12);color:#f87171;border:1px solid rgba(248,113,113,0.2); }
  .badge-a { display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:99px;font-size:10px;font-weight:700;background:rgba(96,165,250,0.12);color:#93c5fd;border:1px solid rgba(96,165,250,0.2); }

  .qty-in  { color:#34d399; font-weight:700; font-family:monospace; }
  .qty-out { color:#f87171; font-weight:700; font-family:monospace; }

  .btn-alert {
    width: 100%; margin-top: 14px; padding: 9px; border-radius: 10px; border: none;
    background: rgba(168,85,247,0.1); border: 1px solid rgba(168,85,247,0.2);
    color: rgba(168,85,247,0.8); font-size: 12px; font-family: 'Inter', sans-serif; font-weight: 600;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .btn-alert:hover { background: rgba(168,85,247,0.18); color: #e2d9f3; }
  .btn-alert svg { width: 13px; height: 13px; }

  .spin { display:flex; align-items:center; justify-content:center; height:200px; gap:12px; color:rgba(180,150,255,0.4); font-size:13px; }
  .spinner-ring {
    width: 28px; height: 28px; border-radius: 50%;
    border: 2px solid rgba(150,80,255,0.15);
    border-top-color: #a855f7;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

  <div id="dash">
    <div class="spin">
      <div class="spinner-ring"></div>
      Cargando...
    </div>
  </div>

  <script>
    async function loadDashboard() {
      const root = document.getElementById('dash')!;
      try {
        const res  = await fetch('/api/dashboard');
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        const { totals, byCategory, lowStock, recentMovements } = data;

        function fmx(n: number) { return '$' + Number(n).toLocaleString('es-MX', { minimumFractionDigits: 2 }); }

        // KPIs
        let h = '<div class="kpi-grid">';
        h += kpi('📦','Total Productos', totals.totalProducts, 'pink', '');
        h += kpi('💰','Valor Inventario', fmx(totals.totalValue), 'cyan',
          totals.exchangeRate ? '≈ $' + Number(totals.totalValueUsd).toLocaleString('en-US') + ' USD' : '');
        h += kpi('⚠️','Stock Bajo', totals.lowStockCount, 'amber', '');
        h += kpi('🚫','Sin Stock', totals.outOfStock, 'red', '');
        h += '</div>';

        // Exchange rate
        if (totals.exchangeRate) {
          h += `<div class="exch-bar">
            <span>🌐</span>
            <span>Tipo de cambio en tiempo real</span>
            <strong>$1 USD = $${totals.exchangeRate.toFixed(2)} MXN</strong>
            <span class="exch-src">via open.er-api.com</span>
          </div>`;
        }

        // ===== FILA 1: Gráfica de barras (izq) + Stock Bajo (der) =====
        h += '<div class="two-col" style="grid-template-columns: 2fr 1fr; margin-bottom: 20px;">';

        // Bar Chart - Productos por Categoría
        h += `<div class="panel">
          <div class="panel-head">
            <span class="panel-title">Productos por Categoría</span>
            <span style="font-size:11px;color:rgba(180,150,255,0.4)">${byCategory.length} categorías</span>
          </div>
          <div class="panel-body"><canvas id="chartCat" height="140"></canvas></div>
        </div>`;

        // Low stock panel
        h += `<div class="panel">
          <div class="panel-head">
            <span class="panel-title">Stock Bajo</span>
            <span class="badge-alert">${lowStock.length} alerta${lowStock.length !== 1 ? 's' : ''}</span>
          </div>
          <div class="panel-body">`;
        if (lowStock.length === 0) {
          h += `<div class="no-issues">✅ Todo en orden</div>`;
        } else {
          for (const p of lowStock) {
            const c = p.stock === 0 ? '#f87171' : '#fbbf24';
            h += `<div class="stock-item">
              <div><div class="stock-name">${p.name}</div><div class="stock-sku">${p.sku ?? 'Sin SKU'}</div></div>
              <div class="stock-qty">
                <div class="stock-num" style="color:${c}">${p.stock} ${p.unit}</div>
                <div class="stock-min">mín: ${p.minStock}</div>
              </div>
            </div>`;
          }
          h += `<button class="btn-alert" onclick="checkAlerts()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Enviar alerta por email
          </button>`;
        }
        h += '</div></div>';
        h += '</div>'; // cierra fila 1

        // ===== FILA 2: Doughnut (izq) + Tendencia Movimientos (der) =====
        h += '<div class="two-col">';

        // Doughnut Chart
        h += `<div class="panel">
          <div class="panel-head">
            <span class="panel-title">Distribución de Valor</span>
            <span style="font-size:11px;color:rgba(180,150,255,0.4)">Valor total</span>
          </div>
          <div class="panel-body" style="display:flex; justify-content:center; align-items:center;">
            <div style="width:100%; max-width:180px;"><canvas id="chartVal" height="180"></canvas></div>
          </div>
        </div>`;

        // Movement Trend Chart
        h += `<div class="panel">
          <div class="panel-head">
            <span class="panel-title">Tendencia de Movimientos</span>
            <span style="font-size:11px;color:rgba(180,150,255,0.4)">Últimos registros</span>
          </div>
          <div class="panel-body"><canvas id="chartMove" height="140"></canvas></div>
        </div>`;

        h += '</div>'; // cierra fila 2

        // ===== TABLA: Historial Reciente =====
        h += `<div class="panel" style="margin-top: 20px;">
          <div class="panel-head">
            <span class="panel-title">Historial Reciente</span>
            <a href="/movimientos" class="see-all">Ver todos →</a>
          </div>
          <div style="overflow-x:auto">
          <table class="mini-table">
            <thead><tr>
              <th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Stock</th><th>Razón</th><th>Fecha</th>
            </tr></thead>
            <tbody>`;

        for (const m of recentMovements) {
          const badge = m.type === 'entrada'
            ? `<span class="badge-e">↑ Entrada</span>`
            : m.type === 'salida'
            ? `<span class="badge-s">↓ Salida</span>`
            : `<span class="badge-a">⊙ Ajuste</span>`;
          const qty = `<span class="${m.type === 'salida' ? 'qty-out' : 'qty-in'}">${m.type === 'salida' ? '−' : '+'}${m.quantity}</span>`;
          h += `<tr>
            <td style="color:#e2d9f3;font-weight:500">${m.productName ?? '—'}</td>
            <td>${badge}</td>
            <td>${qty}</td>
            <td style="font-family:monospace;font-weight:600;color:#e2d9f3">${m.newStock}</td>
            <td>${m.reason ?? '—'}</td>
            <td style="font-size:10px;white-space:nowrap">${new Date(m.createdAt).toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'})}</td>
          </tr>`;
        }

        h += '</tbody></table></div></div>';
        root.innerHTML = h;

        // Chart Initialization
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js';
        script.onload = function() {
          const colors = [
            { bg:'rgba(236,72,153,0.45)',  border:'#ec4899' },
            { bg:'rgba(6,182,212,0.45)',   border:'#06b6d4' },
            { bg:'rgba(16,185,129,0.45)',  border:'#10b981' },
            { bg:'rgba(245,158,11,0.45)',  border:'#f59e0b' },
            { bg:'rgba(139,92,246,0.45)',  border:'#8b5cf6' },
            { bg:'rgba(244,63,94,0.45)',   border:'#f43f5e' },
          ];

          // 1. Bar Chart: Products by Category
          const ctxCat = document.getElementById('chartCat') as HTMLCanvasElement;
          // @ts-ignore
          new Chart(ctxCat.getContext('2d'), {
            type: 'bar',
            data: {
              labels: byCategory.map((c: any) => c.categoryName || 'Sin categoría'),
              datasets: [{
                label: 'Productos',
                data: byCategory.map((c: any) => c.count),
                backgroundColor: colors.map(c => c.bg),
                borderColor: colors.map(c => c.border),
                borderWidth: 2, borderRadius: 8, borderSkipped: false,
              }],
            },
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1, color: 'rgba(180,150,255,0.35)' }, grid: { color: 'rgba(150,80,255,0.06)' }, border: { display: false } },
                x: { ticks: { color: 'rgba(180,150,255,0.5)' }, grid: { display: false }, border: { display: false } },
              },
            },
          });

          // 2. Doughnut Chart: Value by Category
          const ctxVal = document.getElementById('chartVal') as HTMLCanvasElement;
          // @ts-ignore
          new Chart(ctxVal.getContext('2d'), {
            type: 'doughnut',
            data: {
              labels: byCategory.map((c: any) => c.categoryName || 'Sin categoría'),
              datasets: [{
                data: byCategory.map((c: any) => c.value),
                backgroundColor: colors.map(c => c.bg),
                borderColor: colors.map(c => c.border),
                borderWidth: 2,
                hoverOffset: 10
              }],
            },
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              cutout: '70%',
            },
          });

          // 3. Line Chart: Movement Trends
          const ctxMove = document.getElementById('chartMove') as HTMLCanvasElement;
          const moveData = [...recentMovements].reverse();
          // @ts-ignore
          new Chart(ctxMove.getContext('2d'), {
            type: 'line',
            data: {
              labels: moveData.map((m: any) => new Date(m.createdAt).toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })),
              datasets: [{
                label: 'Stock Final',
                data: moveData.map((m: any) => m.newStock),
                borderColor: '#a855f7',
                backgroundColor: 'rgba(168,85,247,0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: '#a855f7',
                pointBorderColor: '#fff',
              }],
            },
            options: {
              responsive: true,
              plugins: { legend: { display: false } },
              scales: {
                y: { ticks: { color: 'rgba(180,150,255,0.35)' }, grid: { color: 'rgba(150,80,255,0.06)' }, border: { display: false } },
                x: { ticks: { color: 'rgba(180,150,255,0.5)' }, grid: { display: false }, border: { display: false } },
              },
            },
          });
        };
        document.head.appendChild(script);

      } catch (err: any) {
        document.getElementById('dash')!.innerHTML =
          `<div style="text-align:center;padding:60px;color:rgba(180,150,255,0.4)">
            <p style="font-size:32px;margin-bottom:10px">💥</p>
            <p style="font-weight:700;color:#f87171">Error cargando dashboard</p>
            <p style="font-size:12px;margin-top:6px">${err.message}</p>
          </div>`;
      }
    }

    function kpi(icon: string, label: string, value: any, color: string, sub: string) {
      return `<div class="kpi-card kpi-${color}">
        <p class="kpi-label">${label}</p>
        <div class="kpi-row"><span class="kpi-icon">${icon}</span><span class="kpi-value">${value}</span></div>
        ${sub ? `<p class="kpi-sub">${sub}</p>` : ''}
      </div>`;
    }

    async function checkAlerts() {
      const btn = document.querySelector('.btn-alert') as HTMLButtonElement;
      if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
      try {
        const res  = await fetch('/api/alerts', { method: 'POST' });
        const data = await res.json();
        alert(data.message ?? 'Alerta procesada');
      } catch { alert('Error al enviar'); }
      finally { if (btn) { btn.disabled = false; btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>Enviar alerta por email`; } }
    }

    (window as any).checkAlerts = checkAlerts;
    loadDashboard();
  </script>
</Layout>
---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Movimientos" eyebrow="Bodega · historial" subtitle="Entradas, salidas y ajustes de existencia, del más reciente al más antiguo.">
  <div class="toolbar">
    <div class="input-icon grow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="search" type="search" class="input" placeholder="Buscar por producto o motivo" aria-label="Buscar movimientos" />
    </div>
    <div class="segmented" role="group" aria-label="Filtrar por tipo">
      <button type="button" data-type="" aria-pressed="true">Todos<span class="count" data-count=""></span></button>
      <button type="button" data-type="entrada" aria-pressed="false">Entradas<span class="count" data-count="entrada"></span></button>
      <button type="button" data-type="salida" aria-pressed="false">Salidas<span class="count" data-count="salida"></span></button>
      <button type="button" data-type="ajuste" aria-pressed="false">Ajustes<span class="count" data-count="ajuste"></span></button>
    </div>
    <button id="refresh" class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.6-6.4L21 8M21 3v5h-5"/></svg>
      Actualizar
    </button>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Producto</th>
            <th>Tipo</th>
            <th class="r">Cantidad</th>
            <th class="r hide-sm">Antes</th>
            <th class="r">Después</th>
            <th class="hide-sm">Motivo</th>
          </tr>
        </thead>
        <tbody id="movTable"></tbody>
      </table>
    </div>
    <div id="movFooter" class="card-foot"><span class="skeleton" style="width:120px"></span></div>
  </div>

  <script>
    import { esc, int, dateTime, stateHtml, skeletonRows } from '@/lib/ui';
    import { productImage } from '@/lib/catalog';

    let all: any[] = [];
    let type = '';
    const tbody = document.getElementById('movTable')!;
    const footer = document.getElementById('movFooter')!;
    const search = document.getElementById('search') as HTMLInputElement;

    async function loadMovements() {
      tbody.innerHTML = skeletonRows(7, 10);
      try {
        const res = await fetch('/api/movements?limit=200');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error ' + res.status);
        all = data;
        ['', 'entrada', 'salida', 'ajuste'].forEach(t => {
          const el = document.querySelector('[data-count="' + t + '"]');
          if (el) el.textContent = String(t ? all.filter(m => m.type === t).length : all.length);
        });
        render();
      } catch (err: any) {
        tbody.innerHTML = '<tr><td colspan="7">' + stateHtml('error', 'No se pudo cargar el historial', err.message) + '</td></tr>';
        footer.innerHTML = '';
      }
    }

    const badge = (t: string) =>
      t === 'entrada' ? '<span class="badge badge-success">Entrada</span>'
      : t === 'salida' ? '<span class="badge badge-ink">Salida</span>'
      : '<span class="badge badge-warning">Ajuste</span>';

    function render() {
      const q = search.value.toLowerCase().trim();
      const data = all.filter(m =>
        (!type || m.type === type) &&
        (!q || (m.productName || '').toLowerCase().includes(q) || (m.reason || '').toLowerCase().includes(q)));

      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7">' + stateHtml('empty', all.length ? 'Sin resultados' : 'Sin movimientos', all.length ? 'Ajusta la búsqueda o el filtro de tipo.' : 'Los movimientos aparecen al registrar entradas o salidas desde Productos.') + '</td></tr>';
        footer.innerHTML = '<span>0 registros</span>';
        return;
      }

      tbody.innerHTML = data.map(m => {
        const qty = m.type === 'entrada' ? '<span class="qty-in">+' + int(m.quantity) + '</span>'
          : m.type === 'salida' ? '<span class="qty-out">-' + int(m.quantity) + '</span>'
          : '<span class="qty-adj">' + int(m.quantity) + '</span>';
        return '<tr>' +
          '<td class="nowrap mono" style="color:var(--steel)">' + esc(dateTime(m.createdAt)) + '</td>' +
          '<td><div style="display:flex;align-items:center;gap:12px;min-width:0"><img class="thumb" src="' + esc(productImage({ image: m.productImage, name: m.productName })) + '" alt="" loading="lazy"><div style="min-width:0"><div class="cell-title">' + esc(m.productName ?? 'Producto eliminado') + '</div><div class="cell-sub mono">' + esc(m.productSku ?? '') + '</div></div></div></td>' +
          '<td>' + badge(m.type) + '</td>' +
          '<td class="r">' + qty + '</td>' +
          '<td class="r num subtle hide-sm">' + int(m.previousStock) + '</td>' +
          '<td class="r" style="font:800 22px/1 var(--font-display)">' + int(m.newStock) + '</td>' +
          '<td class="hide-sm muted"><div class="cell-sub" style="font-size:13px;color:var(--text-2)">' + esc(m.reason ?? '') + '</div></td>' +
        '</tr>';
      }).join('');

      const ins = data.filter(m => m.type === 'entrada').reduce((s, m) => s + m.quantity, 0);
      const outs = data.filter(m => m.type === 'salida').reduce((s, m) => s + m.quantity, 0);
      footer.innerHTML = '<span>' + data.length + ' registros' + (all.length >= 200 ? ' (últimos 200)' : '') + '</span>' +
        '<span><span class="qty-in">+' + int(ins) + '</span> entradas, <span class="qty-out">-' + int(outs) + '</span> salidas</span>';
    }

    document.querySelectorAll<HTMLButtonElement>('.segmented button').forEach(btn => btn.addEventListener('click', () => {
      type = btn.dataset.type || '';
      document.querySelectorAll('.segmented button').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
      render();
    }));
    search.addEventListener('input', render);
    document.getElementById('refresh')!.addEventListener('click', loadMovements);
    loadMovements();
  </script>
</Layout>

---
// Página de confirmación de cuenta, InvenTrack
import '../styles/global.css';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success') === 'true';
const name = url.searchParams.get('name') || 'Usuario';
const error = url.searchParams.get('error');
const already = url.searchParams.get('already') === 'true';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{success ? 'Cuenta confirmada' : 'No se pudo confirmar'} · InvenTrack</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#141414" />
  <style>
    body { min-height: 100vh; display: flex; flex-direction: column; }
    .bar-top { background: var(--ink); }
    .bar-top .wrap { display: flex; align-items: center; min-height: 80px; }
    .bar-nav { height: 10px; background: var(--yellow); }
    main { flex: 1; display: grid; place-items: center; padding: 40px 16px; }
    .box { width: 100%; max-width: 480px; background: #fff; border-top: 6px solid var(--yellow); padding: 36px 32px; box-shadow: var(--shadow-sm); }
    .box.err { border-top-color: var(--red); }
    .ic { width: 52px; height: 52px; display: grid; place-items: center; margin-bottom: 18px; }
    .ic svg { width: 26px; height: 26px; }
    .ic.ok { background: var(--green); color: #fff; }
    .ic.err { background: var(--red); color: #fff; }
    h1 { margin: 8px 0 0; font: 800 44px/.95 var(--font-display); text-transform: uppercase; }
    p { margin: 14px 0 0; color: var(--text-2); font-size: 15.5px; line-height: 1.6; }
  </style>
</head>
<body>
  <header class="bar-top"><div class="wrap"><a class="logo" href="/login" aria-label="InvenTrack"><b>INVEN</b><span>TRACK</span></a></div></header>
  <div class="bar-nav"></div>
  <main>
    <div class={`box${success ? '' : ' err'}`}>
      {success ? (
        <>
          <div class="ic ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M20 6 9 17l-5-5"/></svg></div>
          <div class="eyebrow">Confirmación de cuenta</div>
          <h1>{already ? 'Tu cuenta ya estaba confirmada' : 'Cuenta confirmada'}</h1>
          <p>Hola <b style="color:var(--text)">{name}</b>. {already
            ? 'Tu correo ya había sido verificado. Puedes iniciar sesión.'
            : 'Tu correo quedó verificado. Ya puedes entrar a tu bodega en InvenTrack.'}</p>
          <a href="/login" class="btn btn-primary btn-hard btn-block" style="margin-top:28px">Ir a iniciar sesión</a>
        </>
      ) : (
        <>
          <div class="ic err"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
          <div class="eyebrow">Confirmación de cuenta</div>
          <h1>No se pudo confirmar la cuenta</h1>
          <p>{error || 'El enlace puede haber expirado o no es válido.'}</p>
          <a href="/login" class="btn btn-secondary btn-block" style="margin-top:28px">Volver al inicio</a>
        </>
      )}
    </div>
  </main>
</body>
</html>

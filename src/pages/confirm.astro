---
// Página de confirmación de cuenta — InvenTrack
import '../styles/global.css';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success') === 'true';
const name = url.searchParams.get('name') || 'Usuario';
const error = url.searchParams.get('error');
const already = url.searchParams.get('already') === 'true';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{success ? 'Cuenta confirmada' : 'No se pudo confirmar'} · InvenTrack</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    body { min-height: 100vh; display: grid; place-items: center; padding: 16px; }
    .box { width: 100%; max-width: 420px; padding: 32px; text-align: center; }
    .ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; margin: 0 auto 16px; }
    .ic svg { width: 22px; height: 22px; }
    .ic.ok { background: var(--success-soft); color: var(--success); }
    .ic.err { background: var(--danger-soft); color: var(--danger); }
    h1 { margin: 0; font-size: 20px; font-weight: 650; letter-spacing: -0.02em; }
    p { margin: 8px 0 0; color: var(--text-2); font-size: 14px; line-height: 1.6; }
  </style>
</head>
<body>
  <div class="card box">
    {success ? (
      <>
        <div class="ic ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
        <h1>{already ? 'Tu cuenta ya estaba confirmada' : 'Cuenta confirmada'}</h1>
        <p>Hola <b style="color:var(--text)">{name}</b>. {already
          ? 'Tu correo ya había sido verificado. Puedes iniciar sesión.'
          : 'Tu correo quedó verificado. Ya puedes iniciar sesión en InvenTrack.'}</p>
        <a href="/login" class="btn btn-primary btn-block" style="margin-top:24px">Ir a iniciar sesión</a>
      </>
    ) : (
      <>
        <div class="ic err"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></div>
        <h1>No se pudo confirmar la cuenta</h1>
        <p>{error || 'El enlace puede haber expirado o no es válido.'}</p>
        <a href="/login" class="btn btn-secondary btn-block" style="margin-top:24px">Volver al inicio</a>
      </>
    )}
  </div>
</body>
</html>

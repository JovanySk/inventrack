---
import Layout from '../layouts/Layout.astro';
import { db } from '@/db';
import { users } from '@/db/schema';
import { asc } from 'drizzle-orm';

const allUsers = await db.select({
  id: users.id,
  email: users.email,
  name: users.name,
  role: users.role,
  isActive: users.isActive,
  createdAt: users.createdAt,
}).from(users).orderBy(asc(users.name));

const roleLabels: Record<string, string> = {
  admin: 'Administrador',
  empleado: 'Empleado',
  demo: 'Solo lectura',
};
const roleClass: Record<string, string> = { admin: 'badge-accent', empleado: '', demo: '' };
---

<Layout title="Usuarios" subtitle="Cuentas con acceso al sistema">
  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Correo electrónico</th>
            <th>Rol</th>
            <th>Estado</th>
            <th class="hide-sm">Alta</th>
          </tr>
        </thead>
        <tbody>
          {allUsers.map((user) => (
            <tr>
              <td><span class="cell-title">{user.name}</span></td>
              <td class="muted">{user.email}</td>
              <td><span class={`badge no-dot ${roleClass[user.role] ?? ''}`}>{roleLabels[user.role] || user.role}</span></td>
              <td><span class={`badge ${user.isActive ? 'badge-success' : 'badge-danger'}`}>{user.isActive ? 'Activo' : 'Inactivo'}</span></td>
              <td class="subtle num hide-sm">
                {new Date(user.createdAt!).toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' })}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="card-foot"><span>{allUsers.length} usuarios</span><span>Los roles se administran en la base de datos</span></div>
  </div>
</Layout>

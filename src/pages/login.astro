const cookie = Astro.cookies.get('inventrack-session');
if (cookie?.value === 'authenticated') {
  return Astro.redirect('/');
}

// Patrón PRG: el POST siempre redirige, el error viene en ?e=
import '../styles/global.css';
import { EMAIL_REGEX } from '@/lib/validation';
import { copyrightLine, CREDIT_LINE } from '@/lib/footer';

import bcrypt from 'bcryptjs';
import { db } from '@/db';
import { users, rolePermissions, products, categories, stockMovements } from '@/db/schema';
import { eq, count, sql } from 'drizzle-orm';
import { SignJWT } from 'jose';
import { logger } from '@/lib/logger';

const JWT_SECRET = new TextEncoder().encode(process.env.JWT_SECRET || 'super_secret_dev_key_only');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = form.get('email')?.toString()?.trim() || '';
  const password = form.get('password')?.toString() || '';

  if (!email || !password)              return Astro.redirect('/login?e=required');
  if (!EMAIL_REGEX.test(email))         return Astro.redirect('/login?e=invalid-email');

  const [user] = await db.select().from(users).where(eq(users.email, email));

if (!user)                            return Astro.redirect('/login?e=not-found');

// ─── NUEVO: Verificar si el email está confirmado ───
if (user.emailConfirmed === false)    return Astro.redirect('/login?e=not-confirmed');

// Verificar si la cuenta está activa
if (!user.isActive)                   return Astro.redirect('/login?e=inactive');

  // Verificar si la cuenta está bloqueada
  if (user.lockedUntil && new Date(user.lockedUntil) > new Date()) {
    return Astro.redirect('/login?e=locked');
  }

  const valid = await bcrypt.compare(password, user.passwordHash);
  if (!valid) {
    // Manejar intentos fallidos
    const attempts = (user.failedAttempts || 0) + 1;
    const lockTime = attempts >= 5 ? new Date(Date.now() + 15 * 60 * 1000) : null;
    
    await db.update(users).set({ failedAttempts: attempts, lockedUntil: lockTime }).where(eq(users.id, user.id));
    
    if (attempts >= 5) {
      logger.warn(`Cuenta bloqueada por fuerza bruta: ${email}`);
      return Astro.redirect('/login?e=locked');
    }
    return Astro.redirect('/login?e=wrong-pass');
  }

  // Resetear intentos
  await db.update(users).set({ failedAttempts: 0, lockedUntil: null }).where(eq(users.id, user.id));

  // Obtener permisos del rol
  const rolePerms = await db.select({ permission: rolePermissions.permissionId })
    .from(rolePermissions)
    .where(eq(rolePermissions.roleName, user.role));
  const permissions = rolePerms.map(p => p.permission);

  // Generar JWT
  const token = await new SignJWT({ 
    id: user.id, 
    email: user.email, 
    role: user.role, 
    name: user.name,
    permissions 
  })
    .setProtectedHeader({ alg: 'HS256' })
    .setIssuedAt()
    .setExpirationTime('8h')
    .sign(JWT_SECRET);

  const isProd = import.meta.env?.PROD || process.env.NODE_ENV === 'production';

  Astro.cookies.set('inventrack-token', token, {
    path: '/', maxAge: 60 * 60 * 8, httpOnly: true, sameSite: 'lax', secure: isProd
  });
  
  // Guardamos datos UI en cookies seguras (sin httpOnly para que las lea el frontend si es necesario, o en JWT)
  // Pero para mantener compatibilidad con Layout actual:
  Astro.cookies.set('inventrack-user', user.name, { path: '/', maxAge: 60 * 60 * 8, sameSite: 'lax', secure: isProd });
  Astro.cookies.set('inventrack-email', user.email, { path: '/', maxAge: 60 * 60 * 8, sameSite: 'lax', secure: isProd });
  Astro.cookies.set('inventrack-role', user.role, { path: '/', maxAge: 60 * 60 * 8, sameSite: 'lax', secure: isProd });
  
  logger.info(`Login exitoso: ${email}`);
  return Astro.redirect('/');
}

// Leer error del query param (GET después del redirect)
const ERR_MESSAGES: Record<string, string> = {
  'required':      'Todos los campos son obligatorios.',
  'invalid-email': 'Ingresa un correo electrónico válido.',
  'not-found':     'Este correo no está registrado en el sistema.',
  'wrong-pass':    'Contraseña incorrecta. Verifica e intenta de nuevo.',
  'locked':        'Cuenta bloqueada temporalmente. Intenta en 15 minutos.',
  'not-confirmed': 'Tu correo no ha sido confirmado. Revisa tu bandeja de entrada.',
  'inactive':      'Tu cuenta está desactivada. Contacta al administrador.',
};
const errorCode = new URL(Astro.request.url).searchParams.get('e') || '';
const errorMsg  = ERR_MESSAGES[errorCode] || '';

// Cifras del panel lateral (conteos agregados, sin datos sensibles)
let stats: { products: string; categories: string; movements: string } | null = null;
try {
  const [[p], [c], [m]] = await Promise.all([
    db.select({ n: count(products.id) }).from(products).where(eq(products.isActive, true)),
    db.select({ n: count(categories.id) }).from(categories),
    db.select({ n: count(stockMovements.id) }).from(stockMovements).where(sql`${stockMovements.createdAt} >= CURRENT_DATE - INTERVAL '29 days'`),
  ]);
  const f = (n: unknown) => Number(n).toLocaleString('es-MX');
  stats = { products: f(p.n), categories: f(c.n), movements: f(m.n) };
} catch { stats = null; }

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Categorías">
<style is:global>
  .page-grid { display: grid; gap: 20px; max-width: 760px; }

  /* ── Form card ── */
  .form-card {
    border-radius: 14px;
    border: 1px solid rgba(150,80,255,0.14);
    background: rgba(255,255,255,0.025);
    padding: 20px 22px;
  }
  .form-card-title {
    font-size: 13px; font-weight: 600; color: rgba(180,150,255,0.7);
    margin-bottom: 14px; letter-spacing: 0.02em;
  }
  .form-row { display: flex; gap: 10px; align-items: stretch; }
  .form-row input {
    flex: 1; padding: 10px 14px; border-radius: 10px;
    border: 1.5px solid rgba(150,80,255,0.14);
    background: rgba(10,5,25,0.6); color: #e2d9f3;
    font-size: 13px; font-family: 'Inter', sans-serif; outline: none;
    transition: border-color 0.2s;
  }
  .form-row input::placeholder { color: rgba(150,130,200,0.3); }
  .form-row input:focus { border-color: rgba(168,85,247,0.45); }

  .btn-add {
    padding: 10px 20px; border: none; border-radius: 10px;
    background: linear-gradient(135deg, #a855f7, #ec4899);
    color: #fff; font-size: 13px; font-weight: 600;
    font-family: 'Inter', sans-serif; cursor: pointer; white-space: nowrap;
    transition: all 0.2s; box-shadow: 0 4px 16px rgba(168,85,247,0.3);
  }
  .btn-add:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(168,85,247,0.45); }

  /* ── List card ── */
  .list-card {
    border-radius: 14px;
    border: 1px solid rgba(150,80,255,0.12);
    overflow: hidden;
    background: rgba(255,255,255,0.02);
  }
  .list-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(150,80,255,0.1);
    background: rgba(150,80,255,0.04);
  }
  .list-header-title { font-size: 13px; font-weight: 600; color: rgba(180,150,255,0.7); }
  .list-count {
    font-size: 11px; color: rgba(180,150,255,0.4);
    background: rgba(150,80,255,0.1); border: 1px solid rgba(150,80,255,0.15);
    padding: 2px 10px; border-radius: 99px;
  }

  .cat-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid rgba(150,80,255,0.07);
    transition: background 0.15s;
  }
  .cat-row:last-child { border-bottom: none; }
  .cat-row:hover { background: rgba(150,80,255,0.05); }

  .cat-info { display: flex; align-items: center; gap: 12px; }
  .cat-initial {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, rgba(168,85,247,0.2), rgba(236,72,153,0.15));
    border: 1px solid rgba(168,85,247,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 700; color: #c084fc; flex-shrink: 0;
  }
  .cat-name { font-size: 14px; font-weight: 500; color: #e2d9f3; }
  .cat-desc { font-size: 11px; color: rgba(180,150,255,0.4); margin-top: 1px; }

  .cat-actions { display: flex; align-items: center; gap: 10px; }
  .product-count {
    font-size: 11px; font-weight: 600;
    padding: 3px 10px; border-radius: 99px;
    background: rgba(96,165,250,0.1); color: #93c5fd;
    border: 1px solid rgba(96,165,250,0.18);
  }
  .btn-delete {
    display: flex; align-items: center; gap: 5px;
    padding: 5px 12px; border-radius: 8px;
    border: 1px solid rgba(248,113,113,0.18);
    background: rgba(248,113,113,0.06);
    color: rgba(248,113,113,0.6);
    font-size: 11px; font-weight: 500; font-family: 'Inter', sans-serif;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-delete:hover {
    background: rgba(248,113,113,0.14); color: #f87171;
    border-color: rgba(248,113,113,0.35);
  }
  .btn-delete svg { width: 12px; height: 12px; }

  .empty { text-align: center; padding: 40px; font-size: 13px; color: rgba(180,150,255,0.35); }
  .msg { font-size: 12px; margin-top: 8px; color: #6ee7b7; }
  .msg.err { color: #f87171; }
</style>

  <div class="page-grid">

    <!-- Formulario -->
    <div class="form-card">
      <p class="form-card-title">Nueva categoría</p>
      <div class="form-row">
        <input id="catName" type="text" placeholder="Nombre de la categoría" />
        <input id="catDesc" type="text" placeholder="Descripción (opcional)" />
        <button class="btn-add" onclick="addCategory()">+ Agregar</button>
      </div>
      <div id="formMsg" class="msg" style="display:none"></div>
    </div>

    <!-- Lista -->
    <div class="list-card">
      <div class="list-header">
        <span class="list-header-title">Categorías existentes</span>
        <span id="catCount" class="list-count">—</span>
      </div>
      <div id="categoriesList">
        <div class="empty">Cargando...</div>
      </div>
    </div>

  </div>

  <script>
    async function load() {
      const res  = await fetch('/api/categories');
      const data = await res.json();

      const countEl = document.getElementById('catCount')!;
      const list    = document.getElementById('categoriesList')!;
      countEl.textContent = `${data.length} categoría${data.length !== 1 ? 's' : ''}`;

      if (data.length === 0) {
        list.innerHTML = `<div class="empty">Sin categorías. ¡Crea la primera!</div>`;
        return;
      }

      list.innerHTML = data.map((c: any) => `
        <div class="cat-row">
          <div class="cat-info">
            <div class="cat-initial">${c.name.charAt(0).toUpperCase()}</div>
            <div>
              <div class="cat-name">${c.name}</div>
              <div class="cat-desc">${c.description ?? 'Sin descripción'}</div>
            </div>
          </div>
          <div class="cat-actions">
            <span class="product-count">${c.productCount} producto${c.productCount !== 1 ? 's' : ''}</span>
            <button class="btn-delete" onclick="deleteCategory(${c.id}, '${c.name.replace(/'/g, "\\'")}')">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6m4-6v6"/><path d="M9 6V4h6v2"/></svg>
              Eliminar
            </button>
          </div>
        </div>`).join('');
    }

    async function addCategory() {
      const nameEl = document.getElementById('catName') as HTMLInputElement;
      const descEl = document.getElementById('catDesc') as HTMLInputElement;
      const msgEl  = document.getElementById('formMsg')!;
      const name   = nameEl.value.trim();
      const desc   = descEl.value.trim();

      if (!name) {
        msgEl.textContent = '✗ El nombre es obligatorio.';
        msgEl.className = 'msg err';
        (msgEl as HTMLElement).style.display = 'block';
        return;
      }

      const res  = await fetch('/api/categories', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: desc || null }),
      });
      const data = await res.json();
      if (!res.ok) {
        msgEl.textContent = '✗ ' + data.error;
        msgEl.className = 'msg err';
      } else {
        msgEl.textContent = '✓ Categoría creada.';
        msgEl.className = 'msg';
        nameEl.value = ''; descEl.value = '';
        await load();
      }
      (msgEl as HTMLElement).style.display = 'block';
      setTimeout(() => { (msgEl as HTMLElement).style.display = 'none'; }, 3000);
    }

    async function deleteCategory(id: number, name: string) {
      if (!confirm(`¿Eliminar "${name}"?\nLos productos quedarán sin categoría.`)) return;
      const res = await fetch(`/api/categories?id=${id}`, { method: 'DELETE' });
      if (res.ok) await load();
      else { const d = await res.json(); alert(d.error); }
    }

    Object.assign(window, { addCategory, deleteCategory });
    load();
  </script>
</Layout>

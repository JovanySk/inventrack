---
import Layout from '../layouts/Layout.astro';
const role = Astro.cookies.get('inventrack-role')?.value || 'demo';
const canEdit = role === 'admin' || role === 'empleado';
---

<Layout title="Pasillos" eyebrow="Bodega · categorías" subtitle="Cada pasillo agrupa una familia de productos del catálogo.">
  <style is:global>
    .cat-layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 16px; align-items: start; }
    .cat-mark { width: 56px; height: 56px; object-fit: contain; background: #fff; border: 4px solid var(--yellow); flex-shrink: 0; }
    .cat-aisle { font: 700 11px/1 var(--font-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--steel); }
    .cat-cell a { color: inherit; text-decoration: none; }
    .cat-cell a:hover .cell-title { text-decoration: underline; text-decoration-color: var(--yellow-deep); text-decoration-thickness: 2px; text-underline-offset: 3px; }
    .cat-cell { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .share { display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; }
    .share-track { width: 96px; height: 6px; background: var(--border); overflow: hidden; }
    .share-track span { display: block; height: 100%; background: var(--yellow-deep); }
    .share .num { font: 800 22px/1 var(--font-display); }
    @media (max-width: 900px) { .cat-layout { grid-template-columns: minmax(0, 1fr); } }
  </style>

  <div class="cat-layout">
    <div class="card">
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th>Categoría</th><th class="r">Productos</th><th class="r"><span class="sr-only">Acciones</span></th></tr>
          </thead>
          <tbody id="categoriesList"></tbody>
        </table>
      </div>
      <div class="card-foot" id="catCount"><span class="skeleton" style="width:100px"></span></div>
    </div>

    {canEdit ? (
      <form class="card" id="catForm">
        <div class="card-head"><div><h3 class="card-title">Nuevo pasillo</h3><p class="card-sub">Crea una categoría; aparecerá en filtros y formularios.</p></div></div>
        <div class="card-body" style="display:grid;gap:14px">
          <div class="field">
            <label class="label" for="catName">Nombre</label>
            <input id="catName" type="text" class="input" placeholder="Ej. Plomería" required />
          </div>
          <div class="field">
            <label class="label" for="catDesc">Descripción</label>
            <textarea id="catDesc" class="textarea" rows="2" placeholder="Opcional"></textarea>
          </div>
          <div id="formMsg" class="notice" style="display:none"></div>
          <button class="btn btn-primary btn-block" type="submit">Agregar pasillo</button>
        </div>
      </form>
    ) : (
      <div class="card"><div class="card-body"><div class="notice accent">Tu rol es de solo lectura. Pide a un administrador que agregue categorías.</div></div></div>
    )}
  </div>

  <div id="perm" data-edit={canEdit ? '1' : '0'} hidden></div>

  <script>
    import { esc, toast, icons, stateHtml, skeletonRows } from '@/lib/ui';
    import { categoryImage } from '@/lib/catalog';

    const canEdit = document.getElementById('perm')!.dataset.edit === '1';
    const list = document.getElementById('categoriesList')!;
    const countEl = document.getElementById('catCount')!;

    async function load() {
      list.innerHTML = skeletonRows(3, 6);
      try {
        const res = await fetch('/api/categories');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Error ' + res.status);
        const total = data.reduce((s: number, c: any) => s + Number(c.productCount), 0) || 1;
        countEl.innerHTML = '<span>' + data.length + ' pasillos</span><span>' + total + ' productos asignados</span>';
        if (data.length === 0) {
          list.innerHTML = '<tr><td colspan="3">' + stateHtml('empty', 'Sin categorías', 'Crea la primera con el formulario.') + '</td></tr>';
          return;
        }
        list.innerHTML = [...data].sort((a: any, b: any) => a.id - b.id).map((c: any) => {
          const n = Number(c.productCount);
          return '<tr>' +
            '<td><div class="cat-cell"><img class="cat-mark" src="' + esc(categoryImage(c.name)) + '" alt="" loading="lazy"><a href="/productos?pasillo=' + c.id + '" style="min-width:0"><div class="cat-aisle">Pasillo ' + c.id + '</div><div class="cell-title">' + esc(c.name) + '</div><div class="cell-sub">' + esc(c.description || 'Sin descripción') + '</div></a></div></td>' +
            '<td class="r"><span class="share"><span class="share-track hide-sm"><span style="width:' + Math.max(3, (n / total) * 100 * 2.5) + '%"></span></span><span class="num" style="min-width:20px">' + n + '</span></span></td>' +
            '<td class="r">' + (canEdit ? '<button class="icon-btn danger" data-id="' + c.id + '" data-name="' + esc(c.name) + '" title="Eliminar" aria-label="Eliminar ' + esc(c.name) + '">' + icons.trash + '</button>' : '') + '</td>' +
          '</tr>';
        }).join('');
      } catch (err: any) {
        list.innerHTML = '<tr><td colspan="3">' + stateHtml('error', 'No se pudieron cargar las categorías', err.message) + '</td></tr>';
      }
    }

    list.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-id]');
      if (!btn) return;
      if (!confirm('Eliminar "' + btn.dataset.name + '"? Sus productos quedarán sin categoría.')) return;
      const res = await fetch('/api/categories?id=' + btn.dataset.id, { method: 'DELETE' });
      if (res.ok) { toast('Categoría eliminada', 'success'); load(); }
      else { const d = await res.json(); toast(d.error || 'No se pudo eliminar', 'error'); }
    });

    document.getElementById('catForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nameEl = document.getElementById('catName') as HTMLInputElement;
      const descEl = document.getElementById('catDesc') as HTMLTextAreaElement;
      const msg = document.getElementById('formMsg')!;
      const name = nameEl.value.trim();
      if (!name) { msg.textContent = 'El nombre es obligatorio.'; msg.className = 'notice danger'; msg.style.display = 'flex'; return; }
      const res = await fetch('/api/categories', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description: descEl.value.trim() || null }),
      });
      const data = await res.json();
      if (!res.ok) { msg.textContent = data.error || 'No se pudo crear.'; msg.className = 'notice danger'; msg.style.display = 'flex'; return; }
      msg.style.display = 'none';
      nameEl.value = ''; descEl.value = '';
      toast('Categoría creada', 'success');
      load();
    });

    load();
  </script>
</Layout>

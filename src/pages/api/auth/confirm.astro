---
import Layout from '../layouts/Layout.astro';

const url = new URL(Astro.request.url);
const success = url.searchParams.get('success') === 'true';
const name = url.searchParams.get('name') || 'Usuario';
const error = url.searchParams.get('error');
const already = url.searchParams.get('already') === 'true';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{success ? 'Cuenta Confirmada' : 'Error'} — InvenTrack</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: #07000f;
    }
    .bg-scene {
      position: fixed; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse at 15% 50%, rgba(120,40,200,0.12) 0%, transparent 50%),
        radial-gradient(ellipse at 85% 20%, rgba(236,72,153,0.08) 0%, transparent 50%),
        #07000f;
    }
    .sphere {
      position: absolute; border-radius: 50%;
      animation: floatSphere linear infinite;
    }
    @keyframes floatSphere {
      0%   { transform: translateY(0px); }
      33%  { transform: translateY(-20px); }
      66%  { transform: translateY(10px); }
      100% { transform: translateY(0px); }
    }
    .card {
      position: relative; z-index: 10;
      width: 100%; max-width: 440px; margin: 20px;
      padding: 44px 40px;
      border-radius: 28px;
      backdrop-filter: blur(24px);
      text-align: center;
      animation: fadeIn 0.6s ease-out;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .card-success {
      background: linear-gradient(160deg, rgba(16,185,129,0.18) 0%, rgba(40,10,120,0.08) 100%);
      border: 1px solid rgba(16,185,129,0.25);
      box-shadow: 0 0 80px rgba(16,185,129,0.1), 0 30px 60px rgba(0,0,0,0.5);
    }
    .card-error {
      background: linear-gradient(160deg, rgba(239,68,68,0.18) 0%, rgba(40,10,120,0.08) 100%);
      border: 1px solid rgba(239,68,68,0.25);
      box-shadow: 0 0 80px rgba(239,68,68,0.1), 0 30px 60px rgba(0,0,0,0.5);
    }
    .icon-box {
      width: 80px; height: 80px;
      border-radius: 22px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 36px; color: white;
      margin-bottom: 24px;
      animation: bounceIn 0.8s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes bounceIn {
      from { transform: scale(0); }
      to { transform: scale(1); }
    }
    .icon-success {
      background: linear-gradient(135deg, #10b981, #34d399);
      box-shadow: 0 8px 40px rgba(16,185,129,0.4);
    }
    .icon-error {
      background: linear-gradient(135deg, #ef4444, #f87171);
      box-shadow: 0 8px 40px rgba(239,68,68,0.4);
    }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 12px; }
    .text-success { color: #34d399; }
    .text-error { color: #f87171; }
    .subtitle { color: rgba(200,180,255,0.6); font-size: 16px; line-height: 1.6; margin-bottom: 8px; }
    .name-highlight { color: #d946ef; font-weight: 700; }
    .description { color: rgba(200,180,255,0.4); font-size: 14px; margin-bottom: 32px; }
    .btn {
      display: inline-block; width: 100%;
      padding: 16px; border: none; border-radius: 14px;
      font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700;
      color: white; cursor: pointer;
      text-decoration: none; text-align: center;
      transition: all 0.3s ease;
      letter-spacing: 0.3px;
    }
    .btn-primary {
      background: linear-gradient(135deg, #9333ea, #ec4899);
      box-shadow: 0 6px 30px rgba(147,51,234,0.35);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(147,51,234,0.5);
    }
    .btn-secondary {
      background: rgba(100,80,160,0.2);
      border: 1px solid rgba(150,80,255,0.15);
    }
    .btn-secondary:hover {
      background: rgba(100,80,160,0.3);
      transform: translateY(-2px);
    }
    @media (max-width: 480px) {
      .card { padding: 32px 24px; border-radius: 22px; }
      h1 { font-size: 24px; }
    }
  </style>
</head>
<body>
  <!-- Fondo -->
  <div class="bg-scene">
    <div class="sphere" style="width:160px;height:160px;top:6%;left:10%;background:radial-gradient(circle at 30% 30%, rgba(180,80,255,0.35), rgba(120,30,200,0.05));animation-duration:8s;"></div>
    <div class="sphere" style="width:220px;height:220px;bottom:8%;right:5%;background:radial-gradient(circle at 40% 30%, rgba(200,80,255,0.25), rgba(100,20,180,0.03));animation-duration:10s;"></div>
    <div class="sphere" style="width:90px;height:90px;top:40%;right:15%;background:radial-gradient(circle at 30% 30%, rgba(236,72,153,0.3), rgba(180,40,200,0.05));animation-duration:6s;"></div>
  </div>

  {success ? (
    <div class="card card-success">
      <div class="icon-box icon-success">✓</div>
      <h1 class="text-success">
        {already ? '¡Ya estaba confirmada!' : '¡Cuenta Confirmada!'}
      </h1>
      <p class="subtitle">
        Hola <span class="name-highlight">{name}</span>
      </p>
      <p class="description">
        {already
          ? 'Tu cuenta ya había sido confirmada anteriormente. Puedes iniciar sesión.'
          : 'Tu correo ha sido verificado exitosamente. Ya puedes iniciar sesión en InvenTrack.'
        }
      </p>
      <a href="/login" class="btn btn-primary">
        🚀 Ir a Iniciar Sesión
      </a>
    </div>
  ) : (
    <div class="card card-error">
      <div class="icon-box icon-error">✗</div>
      <h1 class="text-error">Error de Confirmación</h1>
      <p class="description">
        {error || 'No se pudo confirmar la cuenta. El enlace puede haber expirado o ser inválido.'}
      </p>
      <a href="/login" class="btn btn-secondary">
        ← Volver al Inicio
      </a>
    </div>
  )}
</body>
</html>
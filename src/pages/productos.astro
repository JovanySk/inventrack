---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Productos">

  <!-- Toolbar -->
  <div class="flex flex-col sm:flex-row gap-3 mb-8">
    <div class="relative flex-1">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
      <input id="searchInput" type="text" placeholder="Buscar por nombre o SKU..." class="input pl-10" />
    </div>
    <select id="categoryFilter" class="input w-52">
      <option value="">Todas las categorías</option>
    </select>
    <button onclick="openModal()" class="btn-primary whitespace-nowrap flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Nuevo Producto
    </button>
  </div>

  <!-- Tabla -->
  <div class="card p-0 overflow-hidden glow-violet">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-gray-800">
          <tr>
            <th class="text-left py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Producto</th>
            <th class="text-left py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">SKU</th>
            <th class="text-left py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Categoría</th>
            <th class="text-right py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Precio</th>
            <th class="text-center py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Stock</th>
            <th class="text-center py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Estado</th>
            <th class="text-center py-4 px-5 text-gray-500 font-semibold text-xs uppercase tracking-wider">Acciones</th>
          </tr>
        </thead>
        <tbody id="productsTable">
          <tr><td colspan="7" class="text-center py-16 text-gray-500">
            <div class="w-10 h-10 rounded-2xl border-2 border-violet-500 border-t-transparent animate-spin mx-auto mb-3"></div>
            Cargando productos...
          </td></tr>
        </tbody>
      </table>
    </div>
    <div id="tableFooter" class="px-5 py-4 border-t border-gray-800/60 text-xs text-gray-500 font-medium"></div>
  </div>

  <!-- Modal crear/editar producto -->
  <div id="modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-2xl shadow-violet-500/10 w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-5 border-b border-gray-800">
        <h2 id="modalTitle" class="text-lg font-bold text-white">Nuevo Producto</h2>
        <button onclick="closeModal()" class="text-gray-500 hover:text-gray-300 text-2xl transition-colors">&times;</button>
      </div>
      <form id="productForm" class="px-6 py-5 space-y-4">
        <input type="hidden" id="productId" />
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label class="label">Nombre *</label>
            <input id="pName" type="text" class="input" required placeholder="Ej: Laptop Dell XPS 13" />
          </div>
          <div>
            <label class="label">SKU</label>
            <input id="pSku" type="text" class="input" placeholder="Ej: ELEC-001" />
          </div>
          <div>
            <label class="label">Categoría</label>
            <select id="pCategory" class="input">
              <option value="">Sin categoría</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="label">Descripción</label>
            <textarea id="pDesc" class="input h-20 resize-none" placeholder="Descripción del producto..."></textarea>
          </div>
          <div>
            <label class="label">Precio (MXN) *</label>
            <input id="pPrice" type="number" step="0.01" min="0" class="input" required placeholder="0.00" />
          </div>
          <div>
            <label class="label">Unidad</label>
            <select id="pUnit" class="input">
              <option value="pza">Pieza (pza)</option>
              <option value="kg">Kilogramo (kg)</option>
              <option value="lt">Litro (lt)</option>
              <option value="caja">Caja</option>
              <option value="set">Set</option>
              <option value="resma">Resma</option>
              <option value="rollo">Rollo</option>
            </select>
          </div>
          <div>
            <label class="label">Stock Actual</label>
            <input id="pStock" type="number" min="0" class="input" placeholder="0" value="0" />
          </div>
          <div>
            <label class="label">Stock Mínimo</label>
            <input id="pMinStock" type="number" min="0" class="input" placeholder="5" value="5" />
          </div>
        </div>
      </form>
      <div class="flex gap-3 px-6 py-5 border-t border-gray-800 bg-gray-900/50 rounded-b-2xl">
        <button onclick="closeModal()" class="btn-secondary flex-1">Cancelar</button>
        <button onclick="saveProduct()" id="saveBtn" class="btn-primary flex-1">Guardar</button>
      </div>
    </div>
  </div>

  <!-- Modal movimiento de stock -->
  <div id="movModal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl shadow-2xl shadow-violet-500/10 w-full max-w-md">
      <div class="flex items-center justify-between px-6 py-5 border-b border-gray-800">
        <h2 class="text-lg font-bold text-white">Registrar Movimiento</h2>
        <button onclick="closeMovModal()" class="text-gray-500 hover:text-gray-300 text-2xl transition-colors">&times;</button>
      </div>
      <div class="px-6 py-5 space-y-4">
        <input type="hidden" id="movProductId" />
        <p id="movProductName" class="font-semibold text-gray-200 bg-gray-800/60 border border-gray-700/40 px-4 py-3 rounded-xl text-sm"></p>
        <div>
          <label class="label">Tipo de movimiento</label>
          <select id="movType" class="input">
            <option value="entrada">↑ Entrada (sumar stock)</option>
            <option value="salida">↓ Salida (restar stock)</option>
            <option value="ajuste">⟳ Ajuste (establecer stock)</option>
          </select>
        </div>
        <div>
          <label class="label">Cantidad</label>
          <input id="movQty" type="number" min="1" class="input" placeholder="Ej: 10" />
        </div>
        <div>
          <label class="label">Razón</label>
          <input id="movReason" type="text" class="input" placeholder="Ej: Compra proveedor, venta, etc." />
        </div>
      </div>
      <div class="flex gap-3 px-6 py-5 border-t border-gray-800 bg-gray-900/50 rounded-b-2xl">
        <button onclick="closeMovModal()" class="btn-secondary flex-1">Cancelar</button>
        <button onclick="saveMovement()" class="btn-primary flex-1">Registrar</button>
      </div>
    </div>
  </div>

    <script>
    let allProducts: any[] = [];
    let categories: any[]  = [];

    // ── Helper para formatear precios ──
    function fmtPrice(price: any) {
      return '$' + Number(price).toLocaleString('es-MX', { minimumFractionDigits: 2 });
    }

    async function load() {
      const [prodRes, catRes] = await Promise.all([
        fetch('/api/products').then(r => r.json()),
        fetch('/api/categories').then(r => r.json()),
      ]);
      allProducts = prodRes;
      categories  = catRes;
      populateCategorySelects();
      renderTable(allProducts);
    }

    function populateCategorySelects() {
      const opts = categories.map((c: any) => '<option value="' + c.id + '">' + c.name + '</option>').join('');
      document.getElementById('categoryFilter')!.innerHTML = '<option value="">Todas las categorías</option>' + opts;
      document.getElementById('pCategory')!.innerHTML      = '<option value="">Sin categoría</option>' + opts;
    }

    function stockBadge(stock: number, minStock: number) {
      if (stock === 0)       return '<span class="badge-danger">Sin stock</span>';
      if (stock <= minStock)  return '<span class="badge-warning">Stock bajo</span>';
      return '<span class="badge-success">OK</span>';
    }

    function renderTable(data: any[]) {
      const tbody  = document.getElementById('productsTable')!;
      const footer = document.getElementById('tableFooter')!;

      if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-16 text-gray-500">' +
          '<p class="text-4xl mb-3">📦</p>' +
          '<p class="font-medium">No se encontraron productos</p>' +
          '</td></tr>';
        footer.textContent = '';
        return;
      }

      let rows = '';
      for (const p of data) {
        const safeName = p.name.replace(/'/g, "\\'");
        const stockColor = p.stock === 0 ? 'text-red-400' : p.stock <= p.minStock ? 'text-amber-400' : 'text-emerald-400';

        rows += '<tr class="border-b border-gray-800/50 hover:bg-gray-800/30 transition-all duration-200 group">';

        // Producto
        rows += '<td class="py-4 px-5">';
        rows += '<p class="font-semibold text-gray-200 group-hover:text-white transition-colors">' + p.name + '</p>';
        rows += '<p class="text-xs text-gray-600 truncate max-w-xs mt-0.5">' + (p.description || '') + '</p>';
        rows += '</td>';

        // SKU
        rows += '<td class="py-4 px-5">';
        rows += '<span class="font-mono text-xs text-violet-400/70 bg-violet-500/10 px-2 py-1 rounded-lg">' + (p.sku || '—') + '</span>';
        rows += '</td>';

        // Categoría
        rows += '<td class="py-4 px-5">';
        if (p.categoryName) {
          rows += '<span class="badge-info">' + p.categoryName + '</span>';
        } else {
          rows += '<span class="text-gray-600 text-xs">—</span>';
        }
        rows += '</td>';

        // Precio
        rows += '<td class="py-4 px-5 text-right font-mono font-semibold text-gray-200">';
        rows += fmtPrice(p.price);
        rows += '</td>';

        // Stock
        rows += '<td class="py-4 px-5 text-center">';
        rows += '<span class="font-mono font-bold text-lg ' + stockColor + '">' + p.stock + '</span>';
        rows += '<span class="text-[10px] text-gray-600 ml-1">' + p.unit + '</span>';
        rows += '</td>';

        // Estado
        rows += '<td class="py-4 px-5 text-center">' + stockBadge(p.stock, p.minStock) + '</td>';

        // Acciones
        rows += '<td class="py-4 px-5 text-center">';
        rows += '<div class="flex items-center justify-center gap-1.5 opacity-60 group-hover:opacity-100 transition-opacity">';

        // Botón movimiento
        rows += '<button onclick="openMovModal(' + p.id + ', \'' + safeName + '\')" ';
        rows += 'class="p-2 rounded-lg text-cyan-400 hover:bg-cyan-500/10 border border-transparent hover:border-cyan-500/20 transition-all" title="Movimiento">';
        rows += '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>';
        rows += '</button>';

        // Botón editar
        rows += '<button onclick="editProduct(' + p.id + ')" ';
        rows += 'class="p-2 rounded-lg text-violet-400 hover:bg-violet-500/10 border border-transparent hover:border-violet-500/20 transition-all" title="Editar">';
        rows += '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>';
        rows += '</button>';

        // Botón eliminar
        rows += '<button onclick="deleteProduct(' + p.id + ', \'' + safeName + '\')" ';
        rows += 'class="p-2 rounded-lg text-red-400 hover:bg-red-500/10 border border-transparent hover:border-red-500/20 transition-all" title="Eliminar">';
        rows += '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>';
        rows += '</button>';

        rows += '</div></td>';
        rows += '</tr>';
      }

      tbody.innerHTML = rows;

      const totalValue = data.reduce((s: number, p: any) => s + Number(p.price) * p.stock, 0);
      footer.innerHTML = '<div class="flex items-center justify-between">' +
        '<span>' + data.length + ' producto(s)</span>' +
        '<span>Valor total: <strong class="text-emerald-400">' + fmtPrice(totalValue) + ' MXN</strong></span>' +
        '</div>';
    }

    document.getElementById('searchInput')!.addEventListener('input', filter);
    document.getElementById('categoryFilter')!.addEventListener('change', filter);

    function filter() {
      const search = (document.getElementById('searchInput') as HTMLInputElement).value.toLowerCase();
      const catId  = (document.getElementById('categoryFilter') as HTMLSelectElement).value;
      renderTable(allProducts.filter((p: any) => {
        const matchSearch = p.name.toLowerCase().includes(search) || (p.sku || '').toLowerCase().includes(search);
        const matchCat    = !catId || String(p.categoryId) === catId;
        return matchSearch && matchCat;
      }));
    }

    function openModal() {
      (document.getElementById('productForm') as HTMLFormElement).reset();
      (document.getElementById('productId') as HTMLInputElement).value = '';
      document.getElementById('modalTitle')!.textContent = 'Nuevo Producto';
      document.getElementById('modal')!.classList.remove('hidden');
    }

    function closeModal() { document.getElementById('modal')!.classList.add('hidden'); }

    function editProduct(id: number) {
      const p = allProducts.find((x: any) => x.id === id);
      if (!p) return;
      (document.getElementById('productId') as HTMLInputElement).value   = p.id;
      (document.getElementById('pName') as HTMLInputElement).value       = p.name;
      (document.getElementById('pSku') as HTMLInputElement).value        = p.sku || '';
      (document.getElementById('pDesc') as HTMLTextAreaElement).value    = p.description || '';
      (document.getElementById('pPrice') as HTMLInputElement).value      = p.price;
      (document.getElementById('pStock') as HTMLInputElement).value      = p.stock;
      (document.getElementById('pMinStock') as HTMLInputElement).value   = p.minStock;
      (document.getElementById('pUnit') as HTMLSelectElement).value      = p.unit || 'pza';
      (document.getElementById('pCategory') as HTMLSelectElement).value  = p.categoryId || '';
      document.getElementById('modalTitle')!.textContent = 'Editar Producto';
      document.getElementById('modal')!.classList.remove('hidden');
    }

    async function saveProduct() {
      const btn = document.getElementById('saveBtn') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Guardando...';
      const id = (document.getElementById('productId') as HTMLInputElement).value;
      const body = {
        name:       (document.getElementById('pName') as HTMLInputElement).value,
        sku:        (document.getElementById('pSku') as HTMLInputElement).value,
        description:(document.getElementById('pDesc') as HTMLTextAreaElement).value,
        price:      (document.getElementById('pPrice') as HTMLInputElement).value,
        stock:      (document.getElementById('pStock') as HTMLInputElement).value,
        minStock:   (document.getElementById('pMinStock') as HTMLInputElement).value,
        unit:       (document.getElementById('pUnit') as HTMLSelectElement).value,
        categoryId: (document.getElementById('pCategory') as HTMLSelectElement).value || null,
      };
      try {
        const url = id ? '/api/products/' + id : '/api/products';
        const method = id ? 'PUT' : 'POST';
        const res = await fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) { alert(data.error); return; }
        closeModal(); await load();
      } catch (err: any) { alert('Error: ' + err.message); }
      finally { btn.disabled = false; btn.textContent = 'Guardar'; }
    }

    async function deleteProduct(id: number, name: string) {
      const confirmation = prompt('⚠️ CUIDADO: Estás a punto de eliminar "' + name + '".\n\nEscribe la palabra "BORRAR" en mayúsculas para confirmar:');
      if (confirmation !== 'BORRAR') {
        if (confirmation !== null) alert('Eliminación cancelada. Debes escribir "BORRAR".');
        return;
      }
      
      const res = await fetch('/api/products/' + id, { method: 'DELETE' });
      if (res.ok) await load();
      else { const d = await res.json(); alert(d.error); }
    }

    function openMovModal(id: number, name: string) {
      (document.getElementById('movProductId') as HTMLInputElement).value = String(id);
      document.getElementById('movProductName')!.textContent = '📦 ' + name;
      (document.getElementById('movQty') as HTMLInputElement).value = '';
      (document.getElementById('movReason') as HTMLInputElement).value = '';
      document.getElementById('movModal')!.classList.remove('hidden');
    }

    function closeMovModal() { document.getElementById('movModal')!.classList.add('hidden'); }

    async function saveMovement() {
      const id     = (document.getElementById('movProductId') as HTMLInputElement).value;
      const type   = (document.getElementById('movType') as HTMLSelectElement).value;
      const qty    = (document.getElementById('movQty') as HTMLInputElement).value;
      const reason = (document.getElementById('movReason') as HTMLInputElement).value;
      if (!qty || parseInt(qty) <= 0) { alert('Ingresa una cantidad válida'); return; }
      const res = await fetch('/api/movements', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId: id, type: type, quantity: qty, reason: reason }),
      });
      const data = await res.json();
      if (!res.ok) { alert(data.error); return; }
      closeMovModal(); await load();
    }

    Object.assign(window, { openModal, closeModal, editProduct, saveProduct, deleteProduct, openMovModal, closeMovModal, saveMovement });
    load();
  </script>
</Layout>
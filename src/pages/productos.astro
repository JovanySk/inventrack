---
import Layout from '../layouts/Layout.astro';
const role = Astro.cookies.get('inventrack-role')?.value || 'demo';
const canEdit = role === 'admin' || role === 'empleado';
const canDelete = role === 'admin';
---

<Layout title="Productos" subtitle="Catálogo, existencias y movimientos">
  <style is:global>
    .stock-cell { display: inline-flex; flex-direction: column; align-items: flex-end; gap: 4px; }
    .stock-num { font-weight: 600; font-variant-numeric: tabular-nums; }
    .stock-num small { font-weight: 400; color: var(--text-3); margin-left: 3px; font-size: 11.5px; }
    .mov-product { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: var(--radius); background: var(--surface-2); border: 1px solid var(--border); margin-bottom: 16px; }
    .mov-product b { font-weight: 600; font-size: 13.5px; }
    .mov-product span { font-size: 12px; color: var(--text-3); }
    .mov-preview { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px; margin-top: 16px; padding: 12px; border-radius: var(--radius); border: 1px dashed var(--border-strong); text-align: center; }
    .mov-preview .k { font-size: 11.5px; color: var(--text-3); }
    .mov-preview .v { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
    .mov-preview svg { width: 18px; height: 18px; color: var(--text-3); }
    @media (max-width: 640px) { #categoryFilter { width: 100% !important; } #newBtn { margin-left: 0 !important; width: 100%; } .cell-sub { max-width: 170px; } .segmented { width: 100%; } .row-actions .icon-btn.danger { display: none; } }
    .type-picker { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .type-picker label { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--border-strong); border-radius: var(--radius); cursor: pointer; background: var(--surface); }
    .type-picker input { position: absolute; opacity: 0; pointer-events: none; }
    .type-picker b { font-size: 13px; font-weight: 600; }
    .type-picker span { font-size: 11.5px; color: var(--text-3); }
    .type-picker label:has(input:checked) { border-color: var(--accent); box-shadow: var(--ring); background: var(--accent-soft); }
    .type-picker label:has(input:checked) b { color: var(--accent-text); }
    .type-picker label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  </style>

  <div class="toolbar">
    <div class="input-icon grow">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="searchInput" type="search" placeholder="Buscar por nombre o SKU" class="input" aria-label="Buscar productos" />
    </div>
    <select id="categoryFilter" class="select" style="width:220px" aria-label="Filtrar por categoría">
      <option value="">Todas las categorías</option>
    </select>
    <div class="segmented" role="group" aria-label="Filtrar por estado">
      <button type="button" data-status="" aria-pressed="true">Todos<span class="count" data-count="all"></span></button>
      <button type="button" data-status="low" aria-pressed="false">Stock bajo<span class="count" data-count="low"></span></button>
      <button type="button" data-status="out" aria-pressed="false">Agotados<span class="count" data-count="out"></span></button>
    </div>
    {canEdit && (
      <button id="newBtn" class="btn btn-primary" style="margin-left:auto">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
        Nuevo producto
      </button>
    )}
  </div>

  <div class="card">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Producto</th>
            <th class="hide-sm">SKU</th>
            <th class="hide-sm">Categoría</th>
            <th class="r hide-sm">Precio</th>
            <th class="r">Existencia</th>
            <th class="hide-sm">Estado</th>
            <th class="r"><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody id="productsTable"></tbody>
      </table>
    </div>
    <div id="tableFooter" class="card-foot"><span class="skeleton" style="width:140px"></span></div>
  </div>

  <!-- Modal crear/editar producto -->
  <div id="modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal">
      <div class="modal-head">
        <div>
          <h2 id="modalTitle" class="modal-title">Nuevo producto</h2>
          <p class="modal-sub">Los campos marcados con * son obligatorios.</p>
        </div>
        <button class="icon-btn" data-close="modal" aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <form id="productForm" class="modal-body">
        <input type="hidden" id="productId" />
        <div class="form-grid">
          <div class="field span-2">
            <label class="label" for="pName">Nombre *</label>
            <input id="pName" type="text" class="input" required placeholder="Ej. Taladro percutor 1/2 pulgada" />
          </div>
          <div class="field">
            <label class="label" for="pSku">SKU</label>
            <input id="pSku" type="text" class="input" placeholder="Ej. HE-0201" />
          </div>
          <div class="field">
            <label class="label" for="pCategory">Categoría</label>
            <select id="pCategory" class="select"><option value="">Sin categoría</option></select>
          </div>
          <div class="field span-2">
            <label class="label" for="pDesc">Descripción</label>
            <textarea id="pDesc" class="textarea" rows="2" placeholder="Características, medidas o presentación"></textarea>
          </div>
          <div class="field">
            <label class="label" for="pPrice">Precio (MXN) *</label>
            <input id="pPrice" type="number" step="0.01" min="0" class="input" required placeholder="0.00" />
          </div>
          <div class="field">
            <label class="label" for="pUnit">Unidad</label>
            <select id="pUnit" class="select">
              <option value="pza">Pieza (pza)</option>
              <option value="kg">Kilogramo (kg)</option>
              <option value="lt">Litro (lt)</option>
              <option value="caja">Caja</option>
              <option value="paquete">Paquete</option>
              <option value="set">Set</option>
              <option value="cubeta">Cubeta</option>
              <option value="resma">Resma</option>
              <option value="rollo">Rollo</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for="pStock">Existencia actual</label>
            <input id="pStock" type="number" min="0" class="input" value="0" />
          </div>
          <div class="field">
            <label class="label" for="pMinStock">Existencia mínima</label>
            <input id="pMinStock" type="number" min="0" class="input" value="5" />
            <span class="hint">Se genera una alerta al llegar a este nivel.</span>
          </div>
        </div>
        <div id="formError" class="notice danger" style="display:none;margin-top:14px"></div>
      </form>
      <div class="modal-foot">
        <button class="btn btn-secondary" data-close="modal">Cancelar</button>
        <button id="saveBtn" class="btn btn-primary">Guardar producto</button>
      </div>
    </div>
  </div>

  <!-- Modal movimiento de stock -->
  <div id="movModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="movTitle">
    <div class="modal modal-sm">
      <div class="modal-head">
        <div>
          <h2 id="movTitle" class="modal-title">Registrar movimiento</h2>
          <p class="modal-sub">Actualiza la existencia y deja registro en el historial.</p>
        </div>
        <button class="icon-btn" data-close="movModal" aria-label="Cerrar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="movProductId" />
        <div class="mov-product"><b id="movProductName"></b><span id="movProductSku" class="mono"></span></div>
        <div class="field" style="margin-bottom:14px">
          <span class="label">Tipo de movimiento</span>
          <div class="type-picker">
            <label><input type="radio" name="movType" value="entrada" checked /><b>Entrada</b><span>Suma unidades</span></label>
            <label><input type="radio" name="movType" value="salida" /><b>Salida</b><span>Resta unidades</span></label>
            <label><input type="radio" name="movType" value="ajuste" /><b>Ajuste</b><span>Fija el conteo</span></label>
          </div>
        </div>
        <div class="form-grid">
          <div class="field">
            <label class="label" for="movQty">Cantidad</label>
            <input id="movQty" type="number" min="1" class="input" placeholder="0" />
          </div>
          <div class="field">
            <label class="label" for="movReason">Motivo</label>
            <input id="movReason" type="text" class="input" placeholder="Ej. Compra a proveedor" />
          </div>
        </div>
        <div class="mov-preview" aria-live="polite">
          <div><div class="k">Existencia actual</div><div class="v" id="prevStock">0</div></div>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          <div><div class="k">Después del movimiento</div><div class="v" id="nextStock">0</div></div>
        </div>
        <div id="movWarn" class="notice warning" style="display:none;margin-top:12px"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-secondary" data-close="movModal">Cancelar</button>
        <button id="movSaveBtn" class="btn btn-primary">Registrar movimiento</button>
      </div>
    </div>
  </div>

  <div id="perm" data-edit={canEdit ? '1' : '0'} data-delete={canDelete ? '1' : '0'} hidden></div>

  <script>
    import { esc, money, int, toast, icons, stateHtml, skeletonRows } from '@/lib/ui';

    const perm = document.getElementById('perm')!.dataset;
    const canEdit = perm.edit === '1';
    const canDelete = perm.delete === '1';

    let allProducts: any[] = [];
    let categories: any[] = [];
    let status = '';
    const $ = <T extends HTMLElement = HTMLInputElement>(id: string) => document.getElementById(id) as T;

    async function load() {
      $('productsTable').innerHTML = skeletonRows(7, 8);
      try {
        const [prodRes, catRes] = await Promise.all([fetch('/api/products'), fetch('/api/categories')]);
        if (!prodRes.ok) throw new Error((await prodRes.json()).error || 'Error ' + prodRes.status);
        allProducts = await prodRes.json();
        categories = catRes.ok ? await catRes.json() : [];
        populateCategorySelects();
        updateCounts();
        filter();
      } catch (err: any) {
        $('productsTable').innerHTML = '<tr><td colspan="7">' + stateHtml('error', 'No se pudieron cargar los productos', err.message) + '</td></tr>';
        $('tableFooter').innerHTML = '';
      }
    }

    function populateCategorySelects() {
      const opts = categories.map((c: any) => '<option value="' + c.id + '">' + esc(c.name) + '</option>').join('');
      const cur = $<HTMLSelectElement>('categoryFilter').value;
      $('categoryFilter').innerHTML = '<option value="">Todas las categorías</option>' + opts;
      $<HTMLSelectElement>('categoryFilter').value = cur;
      $('pCategory').innerHTML = '<option value="">Sin categoría</option>' + opts;
    }

    const isLow = (p: any) => p.stock > 0 && p.stock <= p.minStock;
    const isOut = (p: any) => p.stock === 0;

    function updateCounts() {
      const set = (k: string, n: number) => { const el = document.querySelector('[data-count="' + k + '"]'); if (el) el.textContent = String(n); };
      set('all', allProducts.length);
      set('low', allProducts.filter(isLow).length);
      set('out', allProducts.filter(isOut).length);
    }

    function stockBadge(p: any) {
      if (isOut(p)) return '<span class="badge badge-danger">Agotado</span>';
      if (isLow(p)) return '<span class="badge badge-warning">Stock bajo</span>';
      return '<span class="badge badge-success">Disponible</span>';
    }

    function renderTable(data: any[]) {
      const tbody = $('productsTable');
      const footer = $('tableFooter');

      if (data.length === 0) {
        const filtered = allProducts.length > 0;
        tbody.innerHTML = '<tr><td colspan="7">' + stateHtml('empty',
          filtered ? 'Sin resultados' : 'Aún no hay productos',
          filtered ? 'Prueba con otro término de búsqueda o quita los filtros.' : 'Crea tu primer producto o importa un archivo XML.') + '</td></tr>';
        footer.innerHTML = '<span>0 productos</span>';
        return;
      }

      tbody.innerHTML = data.map((p: any) => {
        const ratio = p.minStock > 0 ? p.stock / (p.minStock * 3) : 1;
        const pct = Math.max(isOut(p) ? 0 : 6, Math.min(100, ratio * 100));
        const fillCls = isOut(p) ? 'out' : isLow(p) ? 'warn' : '';
        let actions = '';
        if (canEdit) {
          actions += '<button class="icon-btn" data-act="move" data-id="' + p.id + '" title="Registrar movimiento" aria-label="Registrar movimiento de ' + esc(p.name) + '">' + icons.swap + '</button>';
          actions += '<button class="icon-btn" data-act="edit" data-id="' + p.id + '" title="Editar" aria-label="Editar ' + esc(p.name) + '">' + icons.edit + '</button>';
        }
        if (canDelete) {
          actions += '<button class="icon-btn danger" data-act="delete" data-id="' + p.id + '" title="Eliminar" aria-label="Eliminar ' + esc(p.name) + '">' + icons.trash + '</button>';
        }
        return '<tr>' +
          '<td><div class="cell-title">' + esc(p.name) + '</div><div class="cell-sub">' + esc(p.description || '') + '</div></td>' +
          '<td class="nowrap hide-sm"><span class="mono subtle">' + esc(p.sku || '-') + '</span></td>' +
          '<td class="hide-sm">' + (p.categoryName ? '<span class="tag">' + esc(p.categoryName) + '</span>' : '<span class="subtle">Sin categoría</span>') + '</td>' +
          '<td class="r num nowrap hide-sm">' + esc(money(p.price)) + '</td>' +
          '<td class="r nowrap"><div class="stock-cell"><span class="stock-num">' + int(p.stock) + '<small>' + esc(p.unit) + '</small></span>' +
            '<span class="meter-track" title="Mínimo: ' + p.minStock + '"><span class="meter-fill ' + fillCls + '" style="display:block;width:' + pct + '%"></span></span></div></td>' +
          '<td class="nowrap hide-sm">' + stockBadge(p) + '</td>' +
          '<td class="r nowrap"><div class="row-actions">' + actions + '</div></td>' +
        '</tr>';
      }).join('');

      const totalValue = data.reduce((s: number, p: any) => s + Number(p.price) * p.stock, 0);
      footer.innerHTML = '<span>' + data.length + ' de ' + allProducts.length + ' productos</span>' +
        '<span>Valor mostrado: <b class="num" style="color:var(--text)">' + esc(money(totalValue)) + '</b></span>';
    }

    function filter() {
      const search = $('searchInput').value.toLowerCase().trim();
      const catId = $<HTMLSelectElement>('categoryFilter').value;
      renderTable(allProducts.filter((p: any) => {
        const matchSearch = !search || p.name.toLowerCase().includes(search) || (p.sku || '').toLowerCase().includes(search);
        const matchCat = !catId || String(p.categoryId) === catId;
        const matchStatus = !status || (status === 'low' ? isLow(p) : isOut(p));
        return matchSearch && matchCat && matchStatus;
      }));
    }

    $('searchInput').addEventListener('input', filter);
    $('categoryFilter').addEventListener('change', filter);
    document.querySelectorAll<HTMLButtonElement>('.segmented button').forEach(btn => {
      btn.addEventListener('click', () => {
        status = btn.dataset.status || '';
        document.querySelectorAll('.segmented button').forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
        filter();
      });
    });

    // ── Modales ──
    const open = (id: string) => $(id).classList.add('open');
    const close = (id: string) => $(id).classList.remove('open');
    document.querySelectorAll<HTMLElement>('[data-close]').forEach(b => b.addEventListener('click', (e) => { e.preventDefault(); close(b.dataset.close!); }));
    ['modal', 'movModal'].forEach(id => $(id).addEventListener('mousedown', (e) => { if (e.target === e.currentTarget) close(id); }));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { close('modal'); close('movModal'); } });

    function openNew() {
      $<HTMLFormElement>('productForm').reset();
      $('productId').value = '';
      $('formError').style.display = 'none';
      $('modalTitle').textContent = 'Nuevo producto';
      open('modal');
      setTimeout(() => $('pName').focus(), 50);
    }
    $('newBtn')?.addEventListener('click', openNew);

    function editProduct(id: number) {
      const p = allProducts.find((x: any) => x.id === id);
      if (!p) return;
      $('formError').style.display = 'none';
      $('productId').value = p.id;
      $('pName').value = p.name;
      $('pSku').value = p.sku || '';
      $<HTMLTextAreaElement>('pDesc').value = p.description || '';
      $('pPrice').value = p.price;
      $('pStock').value = p.stock;
      $('pMinStock').value = p.minStock;
      $<HTMLSelectElement>('pUnit').value = p.unit || 'pza';
      $<HTMLSelectElement>('pCategory').value = p.categoryId || '';
      $('modalTitle').textContent = 'Editar producto';
      open('modal');
    }

    async function saveProduct() {
      const btn = $<HTMLButtonElement>('saveBtn');
      const errBox = $('formError');
      btn.disabled = true; btn.textContent = 'Guardando...';
      const id = $('productId').value;
      const body = {
        name: $('pName').value,
        sku: $('pSku').value,
        description: $<HTMLTextAreaElement>('pDesc').value,
        price: $('pPrice').value,
        stock: $('pStock').value,
        minStock: $('pMinStock').value,
        unit: $<HTMLSelectElement>('pUnit').value,
        categoryId: $<HTMLSelectElement>('pCategory').value || null,
      };
      try {
        const res = await fetch(id ? '/api/products/' + id : '/api/products', {
          method: id ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) {
          errBox.textContent = Array.isArray(data.errors) ? data.errors.join(' ') : (data.error || 'No se pudo guardar.');
          errBox.style.display = 'flex';
          return;
        }
        close('modal');
        toast(id ? 'Producto actualizado' : 'Producto creado', 'success');
        await load();
      } catch (err: any) {
        errBox.textContent = 'Error de conexión: ' + err.message;
        errBox.style.display = 'flex';
      } finally {
        btn.disabled = false; btn.textContent = 'Guardar producto';
      }
    }
    $('saveBtn').addEventListener('click', saveProduct);
    $('productForm').addEventListener('submit', (e) => { e.preventDefault(); saveProduct(); });

    async function deleteProduct(id: number) {
      const p = allProducts.find((x: any) => x.id === id);
      if (!p) return;
      const confirmation = prompt('Vas a eliminar "' + p.name + '".\n\nEscribe BORRAR para confirmar:');
      if (confirmation !== 'BORRAR') {
        if (confirmation !== null) toast('Eliminación cancelada: escribe BORRAR para confirmar', 'error');
        return;
      }
      const res = await fetch('/api/products/' + id, { method: 'DELETE' });
      if (res.ok) { toast('Producto eliminado', 'success'); await load(); }
      else { const d = await res.json(); toast(d.error || 'No se pudo eliminar', 'error'); }
    }

    // ── Movimiento ──
    let movProduct: any = null;
    const movType = () => (document.querySelector('input[name="movType"]:checked') as HTMLInputElement).value;

    function updatePreview() {
      if (!movProduct) return;
      const qty = parseInt($('movQty').value) || 0;
      const t = movType();
      const prev = movProduct.stock;
      let next = prev;
      if (t === 'entrada') next = prev + qty;
      if (t === 'salida') next = Math.max(0, prev - qty);
      if (t === 'ajuste') next = qty;
      $('prevStock').textContent = int(prev);
      const nextEl = $('nextStock');
      nextEl.textContent = int(next);
      nextEl.style.color = next === 0 ? 'var(--danger)' : next <= movProduct.minStock ? 'var(--warning)' : 'var(--text)';
      const warn = $('movWarn');
      if (t === 'salida' && qty > prev) {
        warn.textContent = 'La salida supera la existencia actual (' + prev + '). Se registrará hasta llegar a cero.';
        warn.style.display = 'flex';
      } else if (qty > 0 && next <= movProduct.minStock) {
        warn.textContent = 'Quedará en o bajo el mínimo (' + movProduct.minStock + '). Se enviará una alerta de stock bajo.';
        warn.style.display = 'flex';
      } else {
        warn.style.display = 'none';
      }
    }

    function openMovModal(id: number) {
      movProduct = allProducts.find((x: any) => x.id === id);
      if (!movProduct) return;
      $('movProductId').value = String(id);
      $('movProductName').textContent = movProduct.name;
      $('movProductSku').textContent = movProduct.sku || '';
      $('movQty').value = '';
      $('movReason').value = '';
      (document.querySelector('input[name="movType"][value="entrada"]') as HTMLInputElement).checked = true;
      updatePreview();
      open('movModal');
      setTimeout(() => $('movQty').focus(), 50);
    }
    $('movQty').addEventListener('input', updatePreview);
    document.querySelectorAll('input[name="movType"]').forEach(r => r.addEventListener('change', updatePreview));

    async function saveMovement() {
      const id = $('movProductId').value;
      const qty = $('movQty').value;
      if (!qty || parseInt(qty) <= 0) { toast('Ingresa una cantidad mayor a cero', 'error'); $('movQty').focus(); return; }
      const btn = $<HTMLButtonElement>('movSaveBtn');
      btn.disabled = true;
      try {
        const res = await fetch('/api/movements', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: id, type: movType(), quantity: qty, reason: $('movReason').value }),
        });
        const data = await res.json();
        if (!res.ok) { toast(data.error || 'No se pudo registrar', 'error'); return; }
        close('movModal');
        toast('Movimiento registrado. Nueva existencia: ' + data.newStock, 'success');
        await load();
      } finally {
        btn.disabled = false;
      }
    }
    $('movSaveBtn').addEventListener('click', saveMovement);

    // Delegacion de acciones en la tabla
    $('productsTable').addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
      if (!btn) return;
      const id = Number(btn.dataset.id);
      if (btn.dataset.act === 'move') openMovModal(id);
      if (btn.dataset.act === 'edit') editProduct(id);
      if (btn.dataset.act === 'delete') deleteProduct(id);
    });

    // Permite abrir directamente: /productos?filtro=bajo
    const q = new URLSearchParams(location.search);
    if (q.get('filtro') === 'bajo') {
      status = 'low';
      document.querySelectorAll('.segmented button').forEach(b => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.status === 'low')));
    }

    load();
  </script>
</Layout>

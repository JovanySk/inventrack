---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="logo" href="/" aria-label="InvenTrack, ir al resumen"><b>INVEN</b><span>TRACK</span></a>
        <p>Inventario, entradas, salidas y alertas de tu ferretería y papelería, contados pieza por pieza.</p>
        <div class="footer-social" aria-label="Redes sociales (próximamente)">
          {SOCIAL_NETWORKS.map(name => (
            <span class="social-chip" role="img" title="Próximamente" aria-label={`${name} (próximamente)`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor" set:html={icons[name]} /></svg>
            </span>
          ))}
        </div>
      </div>

      <nav class="footer-cols" aria-label="Mapa del sitio">
        {columns.map((col, i) => (
          <div class="footer-col">
            <h2><span class="bin">{String(i + 1).padStart(2, '0')}</span>{col.title}</h2>
            <ul>
              {col.links.map(link => (
                <li><a href={link.href} download={link.download ? '' : undefined}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer-bottom">
      <p>{copyrightLine()}</p>
      <p class="credit">{CREDIT_LINE}</p>
    </div>
  </div>
</footer>

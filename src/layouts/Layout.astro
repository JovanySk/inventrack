---
import '../styles/global.css';
import { db } from '@/db';
import { products, categories } from '@/db/schema';
import { sql, and, eq, asc } from 'drizzle-orm';
import { productImage, isValidProductImage, marqueeName, PLACEHOLDER_IMG } from '@/lib/catalog';

const userName  = Astro.cookies.get('inventrack-user')?.value  || 'Usuario';
const userEmail = Astro.cookies.get('inventrack-email')?.value || '';
const userRole  = Astro.cookies.get('inventrack-role')?.value  || 'demo';

export interface Props {
  title:        string;
  /** Texto pequeño sobre el título grande */
  eyebrow?:     string;
  subtitle?:    string;
  description?: string;
  /** false para páginas que dibujan su propio encabezado (resumen, alertas) */
  heading?:     boolean;
}

const { title, eyebrow, subtitle, description = 'InvenTrack, sistema de gestión de inventario', heading = true } = Astro.props;
const pathname = Astro.url.pathname;
const query = Astro.url.searchParams.get('q') ?? '';

let lowStockCount = 0;
let ribbon: { name: string; img: string }[] = [];
try {
  const [row] = await db
    .select({ n: sql<number>`COUNT(*)` })
    .from(products)
    .where(and(eq(products.isActive, true), sql`${products.stock} <= ${products.minStock}`));
  lowStockCount = Number(row?.n ?? 0);

  // Cinta de productos: hasta 3 por pasillo, cada uno con su propia foto (sin repetir ni la genérica)
  const rows = await db
    .select({ name: products.name, image: products.image, categoryId: products.categoryId, categoryName: categories.name })
    .from(products)
    .leftJoin(categories, eq(products.categoryId, categories.id))
    .where(eq(products.isActive, true))
    .orderBy(asc(products.categoryId), asc(products.id));
  const seen = new Set<string>();
  const perAisle = new Map<number | null, number>();
  for (const r of rows) {
    // foto guardada o, si no hay, la que coincide con su nombre (nunca la foto del pasillo)
    const img = isValidProductImage(r.image) ? r.image! : productImage({ name: r.name });
    const n = perAisle.get(r.categoryId) ?? 0;
    if (img === PLACEHOLDER_IMG || seen.has(img) || n >= 3) continue;
    seen.add(img);
    perAisle.set(r.categoryId, n + 1);
    ribbon.push({ name: marqueeName(r.name), img });
  }
} catch {
  lowStockCount = 0;
}

type NavLink = { href: string; label: string; count?: number };
const links: NavLink[] = [
  { href: '/',            label: 'Resumen' },
  { href: '/productos',   label: 'Productos' },
  { href: '/movimientos', label: 'Movimientos' },
  { href: '/alertas',     label: 'Alertas', count: lowStockCount },
  { href: '/categorias',  label: 'Pasillos' },
  { href: '/xml',         label: 'Importar XML' },
];
if (userRole === 'admin') links.push({ href: '/usuarios', label: 'Usuarios' });

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const roleLabel: Record<string, string> = { admin: 'Administrador', empleado: 'Empleado', demo: 'Solo lectura' };
const star = '<svg class="marquee-star" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0Z"/></svg>';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#141414" />
  <title>{title} · InvenTrack</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label="InvenTrack, ir al resumen"><b>INVEN</b><span>TRACK</span></a>
      <form class="search" action="/productos" method="get" role="search" id="globalSearchForm">
        <label class="sr-only" for="globalSearch">Buscar productos</label>
        <input id="globalSearch" name="q" type="search" value={query} placeholder="Busca por nombre, SKU o pasillo..." autocomplete="off" />
        <button type="submit">BUSCAR</button>
      </form>
      <div class="user-block">
        <div class="name">{userName}</div>
        <div class="meta"><span class="org">{roleLabel[userRole] ?? userRole} · </span><a href="/api/logout" title={`Cerrar sesión${userEmail ? ' de ' + userEmail : ''}`}>Cerrar sesión</a></div>
      </div>
    </div>
  </header>

  <nav class="main-nav" aria-label="Navegación principal">
    <ul class="wrap">
      {links.map(link => (
        <li>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}{link.count ? ` (${link.count})` : ''}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {ribbon.length > 0 && (
    <div class="marquee" aria-label="Productos del catálogo">
      <div class="marquee-track">
        {[0, 1].map(copy => (
          <div class="marquee-group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {ribbon.map(item => (
              <>
                <a class="marquee-item" href={`/productos?q=${encodeURIComponent(item.name)}`} tabindex={copy === 1 ? -1 : undefined}>
                  <img src={item.img} alt="" width="44" height="44" decoding="async" />
                  {item.name}
                </a>
                <Fragment set:html={star} />
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  )}

  <main class="content">
    <div class="wrap">
      {heading && (
        <header class="page-head">
          <div>
            {eyebrow && <div class="eyebrow">{eyebrow}</div>}
            <h1>{title}</h1>
            {subtitle && <p>{subtitle}</p>}
          </div>
          <div class="page-actions"><slot name="actions" /></div>
        </header>
      )}
      <slot />
    </div>
  </main>

  <script>
    // Llegar a una página interna implica login exitoso: limpiar contadores de intentos.
    sessionStorage.removeItem('login-attempts');
    sessionStorage.removeItem('login-locked');
  </script>
</body>
</html>

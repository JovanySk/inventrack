---
import '../styles/global.css';
import { db } from '@/db';
import { products } from '@/db/schema';
import { sql, and, eq } from 'drizzle-orm';

const userName  = Astro.cookies.get('inventrack-user')?.value  || 'Usuario';
const userEmail = Astro.cookies.get('inventrack-email')?.value || '';
const userRole  = Astro.cookies.get('inventrack-role')?.value  || 'demo';

export interface Props {
  title:        string;
  subtitle?:    string;
  description?: string;
}

const { title, subtitle, description = 'InvenTrack, sistema de gestión de inventario' } = Astro.props;
const pathname = Astro.url.pathname;

let lowStockCount = 0;
try {
  const [row] = await db
    .select({ n: sql<number>`COUNT(*)` })
    .from(products)
    .where(and(eq(products.isActive, true), sql`${products.stock} <= ${products.minStock}`));
  lowStockCount = Number(row?.n ?? 0);
} catch {
  lowStockCount = 0;
}

const I = {
  dash: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>`,
  box:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8m18 0v8l-9 5m9-13-9 5m0 8V13m0 8-9-5V8l9 5"/></svg>`,
  tag:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>`,
  swap: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16M7 4 3 8m4-4 4 4m6 12V4m0 16 4-4m-4 4-4-4"/></svg>`,
  bell: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>`,
  file: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z"/><path d="M14 3v6h6M10 13l-2 2 2 2m4-4 2 2-2 2"/></svg>`,
  users:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>`,
};

type NavLink = { href: string; label: string; icon: string; count?: number };
const groups: { label: string; links: NavLink[] }[] = [
  { label: 'General', links: [
    { href: '/',            label: 'Resumen',     icon: I.dash },
    { href: '/alertas',     label: 'Alertas',     icon: I.bell, count: lowStockCount },
  ]},
  { label: 'Inventario', links: [
    { href: '/productos',   label: 'Productos',   icon: I.box },
    { href: '/categorias',  label: 'Categorías',  icon: I.tag },
    { href: '/movimientos', label: 'Movimientos', icon: I.swap },
    { href: '/xml',         label: 'Importar y exportar', icon: I.file },
  ]},
];
if (userRole === 'admin') {
  groups.push({ label: 'Administración', links: [{ href: '/usuarios', label: 'Usuarios', icon: I.users }] });
}

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const roleLabel: Record<string, string> = { admin: 'Administrador', empleado: 'Empleado', demo: 'Solo lectura' };
const initials = userName.split(/\s+/).map(s => s.charAt(0)).join('').slice(0, 2).toUpperCase();
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · InvenTrack</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    .shell { display: grid; grid-template-columns: 232px minmax(0, 1fr); min-height: 100vh; }

    .sidebar { background: var(--surface); border-right: 1px solid var(--border); }
    .sidebar-inner { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 10px; height: 60px; padding: 0 18px; text-decoration: none; color: var(--text); }
    .brand-mark { width: 26px; height: 26px; border-radius: 7px; background: var(--accent); color: var(--on-accent); display: grid; place-items: center; flex-shrink: 0; }
    .brand-mark svg { width: 15px; height: 15px; }
    .brand-name { font-size: 15px; font-weight: 650; letter-spacing: -0.02em; }

    .nav { flex: 1; overflow-y: auto; padding: 8px 10px 16px; }
    .nav-group + .nav-group { margin-top: 18px; }
    .nav-label { font-size: 11px; font-weight: 500; color: var(--text-3); padding: 0 10px 6px; }
    .nav-link {
      display: flex; align-items: center; gap: 10px;
      height: 34px; padding: 0 10px; border-radius: var(--radius);
      font-size: 13px; font-weight: 500; color: var(--text-2); text-decoration: none;
      transition: background-color .12s, color .12s;
    }
    .nav-link :global(svg) { width: 16px; height: 16px; flex-shrink: 0; color: var(--text-3); }
    .nav-link:hover { background: var(--surface-3); color: var(--text); }
    .nav-link.active { background: var(--accent-soft); color: var(--accent-text); }
    .nav-link.active :global(svg) { color: var(--accent); }
    .nav-count {
      margin-left: auto; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 99px;
      display: grid; place-items: center; font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums;
      background: var(--warning-soft); color: var(--warning);
    }

    .user {
      display: flex; align-items: center; gap: 10px;
      margin: 10px; padding: 10px; border-radius: var(--radius);
      border: 1px solid var(--border); background: var(--surface-2);
    }
    .avatar { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-3); color: var(--text-2); font-size: 11.5px; font-weight: 600; flex-shrink: 0; }
    .user-info { flex: 1; min-width: 0; }
    .user-name { font-size: 12.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .user-meta { font-size: 11.5px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .main { display: flex; flex-direction: column; min-width: 0; }
    .topbar {
      position: sticky; top: 0; z-index: 20;
      display: flex; align-items: center; gap: 12px;
      height: 60px; padding: 0 28px;
      background: color-mix(in srgb, var(--bg) 88%, transparent);
      backdrop-filter: saturate(1.4) blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .topbar h1 { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
    .crumb { color: var(--text-3); font-size: 13px; }
    .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 12px; font-size: 12.5px; color: var(--text-3); }
    .topbar .menu-btn { display: none; }
    .content { padding: 24px 28px 40px; max-width: 1440px; width: 100%; }
    .scrim { display: none; }

    @media (max-width: 960px) {
      .shell { grid-template-columns: minmax(0, 1fr); }
      .sidebar {
        position: fixed; left: 0; top: 0; bottom: 0; width: 264px; z-index: 40;
        transform: translateX(-100%); transition: transform .2s ease, visibility .2s; visibility: hidden;
      }
      :global(body.nav-open) .sidebar { transform: none; visibility: visible; box-shadow: var(--shadow-lg); }
      :global(body.nav-open) .scrim { display: block; position: fixed; inset: 0; z-index: 30; background: rgba(16,24,40,.4); }
      .topbar .menu-btn { display: inline-flex; margin-left: -6px; }
      .topbar { padding: 0 16px; }
      .content { padding: 16px 16px 32px; }
      .topbar-date { display: none; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
     <div class="sidebar-inner">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5Z"/><path d="M4 8.5 12 13l8-4.5M12 13v7"/></svg>
        </span>
        <span class="brand-name">InvenTrack</span>
      </a>

      <nav class="nav">
        {groups.map(g => (
          <div class="nav-group">
            <div class="nav-label">{g.label}</div>
            {g.links.map(link => (
              <a href={link.href} class={`nav-link${isActive(link.href) ? ' active' : ''}`} aria-current={isActive(link.href) ? 'page' : undefined}>
                <Fragment set:html={link.icon} />
                {link.label}
                {link.count ? <span class="nav-count" title="Productos en o bajo el mínimo">{link.count}</span> : null}
              </a>
            ))}
          </div>
        ))}
      </nav>

      <div class="user">
        <div class="avatar">{initials}</div>
        <div class="user-info">
          <div class="user-name">{userName}</div>
          <div class="user-meta">{roleLabel[userRole] ?? userRole}</div>
        </div>
        <a href="/api/logout" class="icon-btn" title={`Cerrar sesión${userEmail ? ' de ' + userEmail : ''}`} aria-label="Cerrar sesión">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
        </a>
      </div>
     </div>
    </aside>
    <div class="scrim" id="scrim"></div>

    <div class="main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menuBtn" aria-label="Abrir menú" aria-controls="sidebar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <h1>{title}</h1>
        {subtitle && <span class="crumb hide-sm">{subtitle}</span>}
        <div class="topbar-right">
          <span class="topbar-date" id="today"></span>
        </div>
      </header>

      <main class="content">
        <slot />
      </main>
    </div>
  </div>

  <script>
    const today = document.getElementById('today');
    if (today) {
      const s = new Date().toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });
      today.textContent = s.charAt(0).toUpperCase() + s.slice(1);
    }

    const toggle = (open?: boolean) => document.body.classList.toggle('nav-open', open);
    document.getElementById('menuBtn')?.addEventListener('click', () => toggle());
    document.getElementById('scrim')?.addEventListener('click', () => toggle(false));

    // Llegar a una página interna implica login exitoso: limpiar contadores de intentos.
    sessionStorage.removeItem('login-attempts');
    sessionStorage.removeItem('login-locked');
  </script>
</body>
</html>

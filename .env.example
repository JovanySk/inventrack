# Base de datos
DATABASE_URL=postgres://inventario:secret123@localhost:5432/inventario_db

# JWT
JWT_SECRET=tu_secret_aqui

# Email (Resend). Sin RESEND_API_KEY las alertas solo se registran en consola.
# EMAIL_MODE=log fuerza el modo registro aunque haya API key.
RESEND_API_KEY=
EMAIL_MODE=log

# Email SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=correo@tudominio.com
SMTP_PASS=tu_contraseña
SENDER_NAME=InvenTrack
SENDER_EMAIL=correo@tudominio.com
ALERT_EMAIL=admin@tudominio.com

# App
APP_URL=http://localhost:3000